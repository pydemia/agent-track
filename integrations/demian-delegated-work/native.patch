@@ -0,0 +1,50 @@
+import assert from "node:assert/strict"
+import { createHash } from "node:crypto"
+import path from "node:path"
+import os from "node:os"
+import test from "node:test"
+import { loadDedicatedWorkProfile, DedicatedWorkProfileError, TRUSTED_WORK_SERVICE_PRINCIPAL } from "../src/dedicated-work-profile.ts"
+
+const key = "DEMIAN_WORK_RUNTIME_SIGNING_KEY_TEST"
+const token = Buffer.alloc(32, 11).toString("base64url")
+const metadata = { version: 1, origin: "https://demian.synthetic.invalid", servicePrincipalIds: [TRUSTED_WORK_SERVICE_PRINCIPAL],
+  signingKeys: [{ keyId: "test", secretEnv: key }],
+  policies: [{ bindingId: "test", revision: "1", providerId: "openai-compatible", maximumProviderInvocations: 1, maximumOutputTokens: 64 }] }
+function env(): NodeJS.ProcessEnv {
+  return { DEMIAN_DELEGATED_API: "1", DEMIAN_AUTH_MODE: "trusted", HOST: "127.0.0.1", PORT: "8081",
+    DATABASE_URL: "postgresql://synthetic.invalid/unopened", DEMIAN_API_TOKEN: token,
+    DEMIAN_ORIGINAL_API_TOKEN_SHA256: createHash("sha256").update("different original synthetic token").digest("hex"),
+    DEMIAN_WORK_RUNTIME_CONFIG_FILE: path.join(os.tmpdir(), "synthetic-dedicated-profile.json"),
+    [key]: Buffer.alloc(32, 22).toString("base64url") }
+}
+const load = (value = env(), body: unknown = metadata) => loadDedicatedWorkProfile(value, { readMetadata: () => Buffer.from(JSON.stringify(body)) })
+
+test("dedicated profile requires explicit loopback, distinct bearer and signed trusted service boundary", () => {
+  const selected = load()
+  assert.equal(selected.config.host, "127.0.0.1")
+  assert.equal(selected.config.port, 8081)
+  assert.deepEqual(selected.workRuntime.servicePrincipalIds, [TRUSTED_WORK_SERVICE_PRINCIPAL])
+  assert.deepEqual(selected.config.mountRoots, [])
+  assert.deepEqual(selected.config.corsOrigins, [])
+  assert.equal(selected.config.deviceConnections, false)
+})
+
+test("missing/ordinary profile settings and forbidden selectors cannot silently expose the ordinary API", () => {
+  const changes: Record<string, string | undefined>[] = [
+    { DEMIAN_DELEGATED_API: undefined }, { HOST: undefined }, { HOST: "0.0.0.0" }, { PORT: undefined }, { PORT: "8080" },
+    { DEMIAN_AUTH_MODE: undefined }, { DEMIAN_AUTH_MODE: "keycloak" }, { DEMIAN_API_TOKEN: undefined }, { DEMIAN_API_TOKEN: "short" },
+    { DEMIAN_ORIGINAL_API_TOKEN_SHA256: undefined }, { DEMIAN_ORIGINAL_API_TOKEN_SHA256: createHash("sha256").update(token).digest("hex") },
+    { DEMIAN_WORK_RUNTIME_CONFIG_FILE: undefined }, { DEMIAN_PEER_CONFIG_FILE: "private path" },
+    { DEMIAN_PEER_RUNTIME_MODULE_FILE: "private path" }, { DEMIAN_ASSISTANT_PEER_CONFIG_FILE: "private path" },
+    { DEMIAN_DEPLOYMENT_SERVICES_FILE: "private path" }, { DEMIAN_DEVICE_CONNECTIONS: "1" },
+    { DEMIAN_CORS_ORIGINS: "https://browser.invalid" },
+  ]
+  for (const change of changes) assert.throws(() => load({ ...env(), ...change }), error => {
+    assert.ok(error instanceof DedicatedWorkProfileError)
+    assert.equal(error.message, "Dedicated delegated work profile is unavailable")
+    assert.equal(error.message.includes(token), false)
+    return true
+  })
+  assert.throws(() => load(env(), { ...metadata, servicePrincipalIds: ["00000000-0000-0000-0000-000000000020"] }), DedicatedWorkProfileError)
+  assert.throws(() => load(env(), { ...metadata, servicePrincipalIds: [...metadata.servicePrincipalIds, "00000000-0000-0000-0000-000000000020"] }), DedicatedWorkProfileError)
+})
diff --git a/apps/api/test/dedicated-work-schema.integration.test.ts b/apps/api/test/dedicated-work-schema.integration.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..2619c76863c0ac63c16109308f83ee3f005deefa
--- /dev/null
+++ b/apps/api/test/dedicated-work-schema.integration.test.ts
@@ -0,0 +1,45 @@
+import assert from "node:assert/strict"
+import { randomUUID } from "node:crypto"
+import { readdir, readFile } from "node:fs/promises"
+import test from "node:test"
+import { createDatabase } from "@demian/db"
+import { assertDedicatedWorkSchema, DedicatedWorkProfileError } from "../src/dedicated-work-profile.ts"
+
+const url = process.env.TEST_DATABASE_URL
+test("dedicated startup reads actual schema and refuses missing or disabled receipt/worker/privacy guards", { skip: !url }, async () => {
+  const schema = "dedicated_guard_" + randomUUID().replaceAll("-", "")
+  const admin = createDatabase({ connectionString: url! })
+  const target = new URL(url!); target.searchParams.set("options", "-csearch_path=" + schema)
+  const db = createDatabase({ connectionString: target.href, max: 1 })
+  await admin.query("CREATE SCHEMA " + schema)
+  const client = await db.connect()
+  try {
+    const migrations = new URL("../../../packages/db/migrations/", import.meta.url)
+    for (const file of (await readdir(migrations)).filter(name => name.endsWith(".sql")).sort()) await client.query(await readFile(new URL(file, migrations), "utf8"))
+    await client.query("BEGIN READ ONLY")
+    await assertDedicatedWorkSchema(client)
+    assert.equal((await client.query("SHOW transaction_read_only")).rows[0].transaction_read_only, "on")
+    await client.query("ROLLBACK")
+    for (const [relation, trigger] of [
+      ["runs", "work_runtime_session_requires_delegation"], ["runs", "work_runtime_worker_capability"],
+      ["runs", "prepared_codex_requires_deployment"], ["sessions", "prepared_codex_session_settings"],
+      ["runs", "deployment_execution_worker_capability"],
+      ["runs", "prepared_role_metadata_worker_capability"],
+      ["work_runtime_bindings", "prevent_mixed_deployment_delegation"],
+    ]) {
+      await client.query("BEGIN")
+      await client.query(`ALTER TABLE ${relation} DISABLE TRIGGER ${trigger}`)
+      await assert.rejects(assertDedicatedWorkSchema(client), DedicatedWorkProfileError)
+      await client.query("ROLLBACK")
+    }
+    await client.query("BEGIN")
+    await client.query("DROP VIEW prepared_codex_private_sessions")
+    await assert.rejects(assertDedicatedWorkSchema(client), DedicatedWorkProfileError)
+    await client.query("ROLLBACK")
+    await assertDedicatedWorkSchema(client)
+  } finally {
+    await client.query("ROLLBACK").catch(() => undefined)
+    client.release(); await db.end()
+    await admin.query("DROP SCHEMA " + schema + " CASCADE"); await admin.end()
+  }
+})
