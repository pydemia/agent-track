+import { createHash } from "node:crypto"
+import type { DatabasePool } from "@demian/db"
+import { loadApiConfig } from "./config.ts"
+import { loadWorkRuntimeConfiguration, type WorkRuntimeConfigurationIO } from "./work-runtime-config.ts"
+
+export const TRUSTED_WORK_SERVICE_PRINCIPAL = "00000000-0000-0000-0000-000000000010"
+
+export class DedicatedWorkProfileError extends Error {
+  readonly code = "dedicated_work_profile_unavailable"
+  constructor() { super("Dedicated delegated work profile is unavailable") }
+}
+
+/** Explicit service composition. It never enables the ordinary API's selectors. */
+export function loadDedicatedWorkProfile(env: NodeJS.ProcessEnv = process.env, io: WorkRuntimeConfigurationIO = {}) {
+  try {
+    const bearer = env.DEMIAN_API_TOKEN
+    const originalHash = env.DEMIAN_ORIGINAL_API_TOKEN_SHA256
+    if (env.DEMIAN_DELEGATED_API !== "1" || env.DEMIAN_AUTH_MODE !== "trusted" || env.HOST !== "127.0.0.1"
+        || !env.PORT || !bearer || !/^[A-Za-z0-9_-]{43,512}$/.test(bearer)
+        || !originalHash || !/^[a-f0-9]{64}$/.test(originalHash)
+        || createHash("sha256").update(bearer).digest("hex") === originalHash) throw new DedicatedWorkProfileError()
+    const forbidden = ["DEMIAN_PEER_CONFIG_FILE", "DEMIAN_PEER_RUNTIME_MODULE_FILE",
+      "DEMIAN_ASSISTANT_PEER_CONFIG_FILE", "DEMIAN_DEPLOYMENT_SERVICES_FILE"]
+    if (forbidden.some(name => env[name] !== undefined && env[name] !== "")
+        || (env.DEMIAN_DEVICE_CONNECTIONS !== undefined && !["", "0"].includes(env.DEMIAN_DEVICE_CONNECTIONS))) {
+      throw new DedicatedWorkProfileError()
+    }
+    const config = loadApiConfig(env)
+    if (config.port < 1024 || [3000, 3001, 3100, 8080, 14345].includes(config.port)
+        || config.mountRoots.length || config.corsOrigins.length || config.deviceConnections) throw new DedicatedWorkProfileError()
+    const workRuntime = loadWorkRuntimeConfiguration(env, io)
+    if (!workRuntime || workRuntime.servicePrincipalIds.length !== 1
+        || workRuntime.servicePrincipalIds[0] !== TRUSTED_WORK_SERVICE_PRINCIPAL) throw new DedicatedWorkProfileError()
+    return { config, workRuntime }
+  } catch { throw new DedicatedWorkProfileError() }
+}
+
+/** Read-only startup check. Missing receipt/worker/privacy guards never open a generic API. */
+export async function assertDedicatedWorkSchema(db: Pick<DatabasePool, "query">): Promise<void> {
+  try {
+    const result = await db.query<{ ready: boolean }>(`SELECT
+      to_regclass('work_runtime_bindings') IS NOT NULL
+      AND to_regclass('work_runtime_delegation_nonces') IS NOT NULL
+      AND to_regclass('work_runtime_runs') IS NOT NULL
+      AND to_regclass('deployment_session_bindings') IS NOT NULL
+      AND to_regclass('deployment_run_authorities') IS NOT NULL
+      AND EXISTS (SELECT 1 FROM pg_class WHERE oid=to_regclass('prepared_codex_private_sessions') AND relkind='v')
+      AND NOT EXISTS (SELECT 1 FROM (VALUES
+        ('runs','work_runtime_session_requires_delegation','require_work_runtime_run_receipt'),
+        ('runs','work_runtime_worker_capability','require_work_runtime_worker_capability'),
+        ('runs','deployment_execution_worker_capability','require_deployment_execution_worker'),
+        ('runs','prepared_role_metadata_worker_capability','require_prepared_role_metadata_worker'),
+        ('runs','prepared_codex_requires_deployment','require_prepared_codex_run_pins'),
+        ('sessions','prepared_codex_session_settings','preserve_prepared_codex_session'),
+        ('work_runtime_bindings','prevent_mixed_deployment_delegation','validate_prepared_codex_binding')
+      ) required(relation,trigger_name,function_name) WHERE NOT EXISTS (
+        SELECT 1 FROM pg_trigger t JOIN pg_proc p ON p.oid=t.tgfoid
+        WHERE t.tgrelid=to_regclass(required.relation) AND t.tgname=required.trigger_name
+          AND p.proname=required.function_name AND t.tgenabled IN ('O','A')
+      )) AS ready`)
+    if (result.rows[0]?.ready !== true) throw new DedicatedWorkProfileError()
+  } catch { throw new DedicatedWorkProfileError() }
+}
