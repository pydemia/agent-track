index 0000000000000000000000000000000000000000..d7761bd83f706f62408c389895f564aee2ee4bab
--- /dev/null
+++ b/apps/api/src/dedicated-work-main.ts
@@ -0,0 +1,30 @@
+import { createDatabase } from "@demian/db"
+import { buildServer } from "./server.ts"
+import { loadDedicatedWorkProfile, assertDedicatedWorkSchema } from "./dedicated-work-profile.ts"
+
+// This entry deliberately does not import generic main.ts or any peer/deployment
+// configuration loader. Startup cannot refresh shared deployment policies.
+async function start() {
+  const { config, workRuntime } = loadDedicatedWorkProfile()
+  const db = createDatabase({ connectionString: config.databaseUrl, max: 4 })
+  let app: ReturnType<typeof buildServer> | undefined
+  try {
+    await assertDedicatedWorkSchema(db)
+    app = buildServer({ config, db, workRuntime, deviceConnections: { enabled: false } })
+    // The service boundary emits no request URLs, headers, claims, bodies or DB errors.
+    app.log.level = "silent"
+    app.addHook("onClose", async () => { await db.end() })
+    for (const signal of ["SIGINT", "SIGTERM"] as const) process.once(signal, () => {
+      void app!.close().then(() => { process.exitCode = 0 }, () => { process.exitCode = 1 })
+    })
+    await app.listen({ host: config.host, port: config.port })
+    process.stdout.write(JSON.stringify({ state: "ready", profile: "signed-delegated-work", port: config.port }) + "\n")
+  } catch {
+    if (app) await app.close().catch(() => undefined)
+    else await db.end().catch(() => undefined)
+    throw new Error("Dedicated delegated work API could not start")
+  }
+}
+
+try { await start() }
+catch { process.stderr.write("Dedicated delegated work API unavailable\n"); process.exitCode = 1 }
