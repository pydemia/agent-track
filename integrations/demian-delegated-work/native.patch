+      DEMIAN_WORK_RUNTIME_SIGNING_KEY_SYNTHETIC: key.toString("base64url"), DEMIAN_WORKSPACE_ROOT: root })
+    child = spawn(process.execPath, [path.join(root, "main.mjs")], { env, windowsHide: true, stdio: ["ignore", "pipe", "pipe"] })
+    exited = once(child, "exit")
