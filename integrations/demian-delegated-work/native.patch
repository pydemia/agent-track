index 0000000000000000000000000000000000000000..2ae3d00bca363a440844ae35d7335edc2136a47c
--- /dev/null
+++ b/packages/db/migrations/026_prepared_role_metadata.sql
@@ -0,0 +1,23 @@
+-- Additive fence: descriptive role metadata never implies tool authority.
+-- Keep the existing prepared claim/pin fence from migration 022 intact.
+CREATE FUNCTION require_prepared_role_metadata_worker() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+ IF NEW.status NOT IN ('leasing','running','waiting_for_permission') THEN RETURN NEW; END IF;
+ IF (EXISTS (SELECT 1 FROM work_runtime_runs wr WHERE wr.run_id=NEW.id
+       AND wr.receipt->'binding'->'execution'->>'kind'='prepared-codex-text-v1'
+       AND jsonb_array_length(wr.receipt->'binding'->'toolScope')>0)
+   OR EXISTS (SELECT 1 FROM work_runtime_bindings b
+       WHERE b.organization_id=NEW.organization_id AND b.session_id=NEW.session_id
+       AND b.canonical_binding::jsonb->'execution'->>'kind'='prepared-codex-text-v1'
+       AND jsonb_array_length(b.canonical_binding::jsonb->'toolScope')>0))
+ AND NOT EXISTS (SELECT 1 FROM worker_runtime_capabilities c WHERE c.worker_id=NEW.worker_id
+   AND c.features->'delegated_prepared_codex_v1'='true'::jsonb
+   AND c.features->'delegated_prepared_role_metadata_v1'='true'::jsonb
+   AND c.checked_at BETWEEN clock_timestamp()-interval '90 seconds' AND clock_timestamp())
+ THEN RAISE EXCEPTION 'Worker lacks current prepared role metadata capability'
+   USING ERRCODE='23514', CONSTRAINT='prepared_role_metadata_worker_capability'; END IF;
+ RETURN NEW;
+END;
+$$;
+CREATE TRIGGER prepared_role_metadata_worker_capability BEFORE INSERT OR UPDATE ON runs
+ FOR EACH ROW EXECUTE FUNCTION require_prepared_role_metadata_worker();
