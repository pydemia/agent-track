+    assert.equal((await send("/api/v1/capabilities", { authorization: "Bearer " + bearer })).status, 403)
+    const onceOnly = signed("/api/v1/capabilities")
+    assert.equal((await send("/api/v1/capabilities", onceOnly)).status, 200)
+    assert.equal((await send("/api/v1/capabilities", onceOnly)).status, 409)
+    assert.equal((await send("/api/v1/sessions/" + session, signed("/api/v1/sessions/" + session))).status, 200)
+    assert.equal((await send("/api/v1/workspaces", signed("/api/v1/workspaces"))).status, 403)
+    const canary = "SYNTHETIC_PRIVATE_CANARY_" + randomUUID()
+    assert.equal((await send("/api/v1/sessions/" + session + "/runs", { authorization: "Bearer " + bearer, "content-type": "application/json", "x-request-id": canary }, "POST", "{\"body\":\"" + canary)).status, 400)
+    assert.equal(logs.includes(canary), false); assert.equal(logs.includes(bearer), false); assert.equal(logs.includes(onceOnly["x-demian-delegation"]), false)
+    assert.equal((await db.query("SELECT count(*)::int AS count FROM runs")).rows[0].count, 0)
