+  const target = new URL(databaseUrl!); target.searchParams.set("options", "-csearch_path=" + schema)
+  const db = createDatabase({ connectionString: target.href })
+  let child: ReturnType<typeof spawn> | undefined
+  let exited: Promise<unknown> | undefined
+  let logs = ""
+  try {
+    await admin.query("CREATE SCHEMA " + schema)
+    const migrations = new URL("../../../packages/db/migrations/", import.meta.url)
+    for (const name of (await readdir(migrations)).filter(value => value.endsWith(".sql")).sort()) await db.query(await readFile(new URL(name, migrations), "utf8"))
+    const org = "00000000-0000-0000-0000-000000000001", service = "00000000-0000-0000-0000-000000000010"
+    const workspace = randomUUID(), session = randomUUID()
+    await db.query("INSERT INTO workspaces(id,organization_id,name,root_path,status) VALUES($1,$2,'compiled dedicated fixture','/synthetic','ready')", [workspace, org])
+    await db.query("INSERT INTO sessions(id,organization_id,workspace_id,provider,model,mode,permission_policy) VALUES($1,$2,$3,'synthetic','synthetic-model','single-agent','deny')", [session, org, workspace])
+    const binding = parseTrustedWorkRuntimeBinding({ enabled: true, revision: 1, bindingId: "compiled-" + randomUUID(), origin: "https://demian.synthetic.invalid",
+      audience: "demian", ownerId: "synthetic-owner", runtimeActorId: "synthetic-actor", tenantId: "synthetic", organizationId: org, servicePrincipalId: service,
+      workspaceId: workspace, sessionId: session, kind: "managed", roleContextSha256: "a".repeat(64), policyRevision: "1", model: "synthetic-model", effort: null, readScope: [], toolScope: [] })
+    const actor = await registerWorkRuntimeBinding(db, { binding, actingUserId: service, expectedRevision: 0 })
+    const bearer = Buffer.alloc(32, 24).toString("base64url"), key = Buffer.alloc(32, 25)
+    const configPath = path.join(root, "work.json")
+    await writeFile(configPath, JSON.stringify({ version: 1, origin: binding.origin, servicePrincipalIds: [service], signingKeys: [{ keyId: "synthetic", secretEnv: "DEMIAN_WORK_RUNTIME_SIGNING_KEY_SYNTHETIC" }],
+      policies: [{ bindingId: binding.bindingId, revision: "1", providerId: "openai-compatible", maximumProviderInvocations: 1, maximumOutputTokens: 64 }] }))
+    const compiled = await build({ absWorkingDir: fileURLToPath(new URL("../", import.meta.url)), entryPoints: ["src/dedicated-work-main.ts"], bundle: true, format: "esm", platform: "node", target: "node22", write: false, outfile: path.join(root, "main.mjs"), external: ["pg-native"],
+      banner: { js: "import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);" }, logLevel: "silent" })
+    await writeFile(path.join(root, "main.mjs"), compiled.outputFiles[0]!.contents)
+    const portProbe = http.createServer(); portProbe.listen(0, "127.0.0.1"); await once(portProbe, "listening")
+    const address = portProbe.address(); assert.ok(address && typeof address !== "string")
+    const port = address.port; await new Promise<void>(resolve => portProbe.close(() => resolve()))
+    const env: NodeJS.ProcessEnv = {}
+    for (const name of ["SystemRoot", "SYSTEMROOT", "PATH", "PATHEXT", "TEMP", "TMP"]) if (process.env[name]) env[name] = process.env[name]
+    Object.assign(env, { DEMIAN_DELEGATED_API: "1", HOST: "127.0.0.1", PORT: String(port), DEMIAN_AUTH_MODE: "trusted", DATABASE_URL: target.href,
