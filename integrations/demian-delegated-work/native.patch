+    child.stderr!.on("data", bytes => { logs += bytes })
+    const deadline = Date.now() + 10000
+    while (!logs.includes('"state":"ready"')) {
+      assert.equal(child.exitCode, null, "Dedicated compiled process exited before readiness")
+      assert.ok(Date.now() < deadline, "Dedicated compiled readiness timed out")
+      await new Promise(resolve => setTimeout(resolve, 20))
+    }
+    const send = (url: string, headers: Record<string, string>, method = "GET", body = "") => new Promise<{ status: number; body: string }>((resolve, reject) => {
+      const outgoing = http.request({ hostname: "127.0.0.1", port, path: url, method, headers }, response => {
+        let content = ""; response.on("data", bytes => { content += bytes }); response.on("end", () => resolve({ status: response.statusCode!, body: content }))
+      }); outgoing.on("error", reject); outgoing.end(body)
