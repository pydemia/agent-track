+          await appendRunEvent(db, { runId: result.row.id,
+            type: result.row.status === "cancelled" ? "response.cancelled" : "run.cancelling", data: { status: result.row.status } })
+        } catch {
+          throw new HttpProblem(500, "cancel_committed_event_failed", "Cancellation committed, but its event could not be recorded")
+        }
+      }
+      return reply.status(result.kind === "terminal" ? 200 : 202).send(result.resource)
+    }
