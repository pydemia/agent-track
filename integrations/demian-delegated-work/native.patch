+    await mkdir(stateRoot); await mkdir(workspaceRoot)
+    const toolScope = ["Projects 작업 상태와 결과 연결", "Note 프로젝트 폴더와 산출물 저장"]
+    const skill = { id: "outline-report-writing", revision: "r1", body: "Preserve the actual role and its approved scope.",
+      sha256: hash("Preserve the actual role and its approved scope."), sourceUrl: "https://skills.pydemia.ai/skills/outline-report-writing" }
+    const { body: _, ...reference } = skill
+    const roleContext = { membership: { toolScope, skills: [reference] }, access: { mode: "metadata-only", grantsPermissions: false } }
+    const context = { roleContext, skills: [skill] }
+    const execution = { kind: "prepared-codex-text-v1" as const, serviceId: randomUUID(), serviceRevision: "r1" }
+    const binding = parseTrustedWorkRuntimeBinding({ enabled: true, revision: 1, bindingId: "role", origin: "https://synthetic.invalid",
+      audience: "demian", ownerId: "owner", runtimeActorId: "actor", tenantId: "tenant", organizationId: randomUUID(),
+      servicePrincipalId: randomUUID(), workspaceId: randomUUID(), sessionId: randomUUID(), kind: "managed",
+      roleContextSha256: hash(JSON.stringify(roleContext)), policyRevision: "r1", model: "fixed-model", effort: null,
+      readScope: ["source"], toolScope, execution })
+    const bindingSha256 = hash(JSON.stringify(binding))
+    const receipt: WorkRuntimeRunReceipt = { runId: randomUUID(), organizationId: binding.organizationId,
+      workspaceId: binding.workspaceId, sessionId: binding.sessionId, actingUserId: randomUUID(), servicePrincipalId: binding.servicePrincipalId,
+      binding, bindingSha256, sessionProvider: "prepared", sessionPermissionPolicy: "deny", request: "Write the report.",
+      input: [{ type: "input_text", text: "Write the report." }], correlationId: randomUUID(), requestSha256: hash("Write the report."),
+      contextSha256: hash(JSON.stringify(context)), roleContextSha256: binding.roleContextSha256,
+      canonicalContextJson: JSON.stringify(context), canonicalRoleContextJson: JSON.stringify(roleContext),
+      requestedModel: binding.model, requestedEffort: null, trustedPolicy: { providerId: "codex-app-server", revision: "r1",
+        maximumProviderInvocations: 0, maximumOutputTokens: 0, native: { budgetMode: "provider-unmetered", execution, bindingSha256 } } }
+    const configPath = join(root, "config.json")
+    await writeFile(configPath, JSON.stringify({ defaultProvider: "prepared", providers: { prepared: { type: "codex-app-server", model: "fixed-model",
+      cliPath: process.execPath, personalAuthHome: join(root, "inert-account"), historyPolicy: "passthrough-resume" } } }))
+    let stored: unknown, calls = 0, checks = 0
+    const runtime: DemianRuntimeModule = {
+      async *runPreparedCodexTurn(_, request) {
+        calls++
+        assert.deepEqual(request.agent.tools, [])
+        assert.deepEqual(request.agent.permissions, [])
+        assert.equal(request.agent.defaultDecision, "deny")
+        assert.deepEqual(JSON.parse(request.agent.systemPrompt!), context)
+        assert.equal(request.requireResume, calls > 1)
+        assert.equal(request.previousExternalSessionId, calls > 1 ? "native-thread" : undefined)
+        yield { type: "external.session.started", externalSessionId: "native-thread" }
+        yield { type: "external.lineage.observed", observation: { phase: "turn_started", nativeThreadId: "native-thread", nativeTurnId: randomUUID() } }
+        yield { type: "result", finalAnswer: "Report", externalSessionId: "native-thread" }
+      },
+      async runWebServiceTurn() { throw new Error("ordinary runtime forbidden") },
+      async inspectWebServiceProviders() { throw new Error("inspection forbidden") },
+      async inspectWebServiceCapabilities() { throw new Error("inspection forbidden") },
+      buildSandboxLaunch() { throw new Error("launch forbidden") },
+    }
+    const options: RuntimeTurnOptions = { cwd: workspaceRoot, prompt: receipt.request, agentName: "ignored", providerName: "prepared",
+      mode: "single-agent", permissionPreset: "deny", authorizedProviderProfiles: ["prepared"],
+      configurationSnapshot: await loadIsolatedConfig(configPath), signal: new AbortController().signal,
+      authorizeDispatch: async () => { checks++ }, permissionPrompt: async () => { throw new Error("permissions forbidden") },
+      externalSession: { rootSessionId: receipt.sessionId, store: { load: async () => stored, save: async value => { stored = value } } } }
+    const input = { runtime, options, receipt, stateRoot, workspaceRoot, deploymentPin: "pinned-deployment",
+      requirePrevious: async () => false, recordModel: async () => {} }
+    assert.equal((await runPreparedDelegation(input)).finalAnswer, "Report")
+    assert.equal((await runPreparedDelegation({ ...input, requirePrevious: async () => true })).finalAnswer, "Report")
+    assert.ok(checks >= 10)
+    for (const changed of [
+      { ...input, deploymentPin: "other-deployment" },
+      { ...input, receipt: { ...receipt, canonicalContextJson: JSON.stringify({ ...context, skills: [] }) } },
+      { ...input, receipt: { ...receipt, binding: { ...binding, effort: "high" } } },
+    ]) await assert.rejects(runPreparedDelegation(changed), /unavailable/)
+    assert.equal(calls, 2)
+  } finally {
+    assert.equal(dirname(resolve(root)), resolve(tmpdir()))
+    await rm(root, { recursive: true, force: true })
+  }
+})
