+  assert.equal(first.events.through_sequence, "9223372036854775807")
+  assert.equal(first.events.next_after, "9007199254740994"); assert.equal(first.events.has_more, true)
+  assert.deepEqual(first.events.data.map(row => row.sequence), rows.slice(0, 2).map(row => row.sequence_text))
+  const tail = await readWorkRuntimeEvidence(f.client, actor, run, receipt, {after: first.events.next_after, limit: 2})
+  assert.equal(tail.events.next_after, tail.events.through_sequence); assert.equal(tail.events.has_more, false)
+  const empty = await readWorkRuntimeEvidence(f.client, actor, run, receipt, {after: tail.events.next_after, limit: 1})
+  assert.deepEqual(empty.events.data, []); assert.equal(empty.events.has_more, false)
