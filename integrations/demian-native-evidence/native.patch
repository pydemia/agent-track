index 0000000..2a0bbc2
--- /dev/null
+++ b/apps/api/src/work-runtime-evidence.ts
@@ -0,0 +1,280 @@
+import { createHash } from "node:crypto"
+import type { DatabaseClient, DelegatedWorkRuntimeActor, RunRow } from "@demian/db"
+import { isDeepStrictEqual } from "node:util"
+import { currentPreparedDeployment } from "../../../packages/db/src/work-runtime-runs.ts"
+import type { WorkRuntimeRunReceipt } from "../../../packages/db/src/work-runtime-runs.ts"
+import { readWorkRuntimeArtifacts } from "./work-runtime-artifacts.ts"
+import { MetadataQueryError, parseMetadataQuery } from "./work-runtime-metadata.ts"
+import { WorkRuntimeSignatureError } from "./work-runtime-delegation.ts"
+
+const MAX_BYTES = 786432
+const tokens = ["inputTokens", "outputTokens", "totalTokens", "cachedInputTokens", "reasoningOutputTokens"] as const
+const record = (v: unknown): v is Record<string, unknown> => !!v && typeof v === "object" && !Array.isArray(v)
+const identifier = (v: unknown): v is string => typeof v === "string" && /^[^\x00-\x1f\x7f-\x9f]{1,512}$/u.test(v)
+const model = (v: unknown): v is string => typeof v === "string" && /^[A-Za-z0-9_.:/-]{1,200}$/.test(v)
+const snake = (key: string) => key.replace(/[A-Z]/g, value => `_${value.toLowerCase()}`)
+
+// Invalid presence survives projection as JSON null so aliases cannot hide it.
+function leaves(value: string, keys: readonly string[]) {
+  const fields = keys.map(key => {
+    const isToken = tokens.some(token => key === token || key === snake(token))
+    const isCost = key === "costUsd" || key === "cost_usd"
+    // Check exact PostgreSQL numerics before JSON.parse can round a fractional
+    // token count into a safe integer (or a negative tiny cost into -0).
+    const numeric = isToken || isCost ? `AND CASE WHEN jsonb_typeof(${value}->'${key}')='number' THEN
+      (${value}->>'${key}')::numeric>=0 ${isToken ? `AND (${value}->>'${key}')::numeric<=9007199254740991 AND trunc((${value}->>'${key}')::numeric)=(${value}->>'${key}')::numeric` : ""} ELSE false END` : ""
+    const peers = keys.filter(peer => peer !== key && snake(peer) === snake(key))
+    const consistent = peers.map(peer => `AND (NOT (${value} ? '${peer}') OR ${value}->'${key}'=${value}->'${peer}')`).join(" ")
+    return `'${key}', CASE WHEN jsonb_typeof(${value}->'${key}') IN ('string','number','boolean') AND octet_length((${value}->'${key}')::text)<=4096 ${numeric} ${consistent} THEN ${value}->'${key}' ELSE 'null'::jsonb END`
+  })
+  return `(SELECT COALESCE(jsonb_object_agg(key,value),'{}'::jsonb) FROM jsonb_each(jsonb_build_object(${fields.join(",")})) WHERE ${value} ? key)`
+}
+const observation = (value: string) => `${leaves(value, ["scope", "coverage", "source", "invocationId", "invocation_id", "costUsd", "cost_usd"])} || jsonb_build_object('usage',${leaves(`(${value}->'usage')`, tokens.flatMap(key => [key, snake(key)]))})`
+// Fixed index traversal, never jsonb_array_elements on an unbounded payload.
+const observations = (key: string) => `CASE WHEN data ? '${key}' THEN jsonb_build_object('${key}',
+  CASE WHEN jsonb_typeof(data->'${key}')='array' THEN
+    (SELECT COALESCE(jsonb_agg(CASE WHEN jsonb_typeof(data->'${key}'->i)='object' THEN ${observation(`(data->'${key}'->i)`)} ELSE 'null'::jsonb END ORDER BY i),'[]'::jsonb)
+     FROM generate_series(0,15) i WHERE i<jsonb_array_length(data->'${key}')) ELSE 'null'::jsonb END,
+  '${key}Overflow',CASE WHEN jsonb_typeof(data->'${key}')='array' THEN jsonb_array_length(data->'${key}')>16 ELSE false END) ELSE '{}'::jsonb END`
+
+export const EVIDENCE_EVENTS_SQL = `SELECT run_id,sequence::text AS sequence_text,
+  CASE WHEN octet_length(type)<=128 AND type ~ '^[A-Za-z0-9_.:-]+$' THEN type ELSE 'unknown' END AS type,created_at,
+  CASE WHEN type='run.prepared.selected' THEN ${leaves("data", ["model", "selectedModel", "selected_model"])}
+    WHEN type='response.usage' THEN ${leaves("data", ["invocationId", "invocation_id"])} || ${observations("usageObservations")} || ${observations("usage_observations")}
+      || jsonb_build_object('usageAliasConflict',data ? 'usageObservations' AND data ? 'usage_observations' AND data->'usageObservations' IS DISTINCT FROM data->'usage_observations')
+    ELSE '{}'::jsonb END AS evidence
+  FROM run_events WHERE run_id=$1 AND sequence>$2::bigint AND sequence<=$3::bigint ORDER BY sequence ASC LIMIT $4`
+
+function alias(value: Record<string, unknown>, keys: string[], valid: (v: unknown) => boolean) {
+  const present = keys.filter(key => Object.hasOwn(value, key))
+  if (!present.length) return { present: false, valid: true, value: undefined }
+  const first = value[present[0]]
+  return { present: true, valid: present.every(key => valid(value[key]) && JSON.stringify(value[key]) === JSON.stringify(first)), value: first }
+}
+interface UsageObservation {
+  scope: "invocation" | "latest-model-request" | "native-session" | "unknown"
+  coverage: "complete" | "partial" | "unknown"
+  source: string
+  usage: Partial<Record<typeof tokens[number], number>>
+  invocationId?: string
+  costUsd?: number
+}
+type Lineage = {
+  attempt: number; executor: "codex-app-server"; provider: string; phase: string
+  nativeThreadKey: string; nativeTurnKey: string; nativeItemKey: string | null; invocationId: string | null
+}
+interface EvidenceRecord {
+  runId: string; sequence: string; type: string; occurredAt: string
+  selectedModel: string | null; usageObservations: UsageObservation[]; lineage: Lineage | null
+  issues: ("model-unavailable" | "usage-unavailable" | "lineage-unavailable")[]
+}
+type EventRow = {run_id: string; sequence_text: string; type: string; created_at: Date; evidence: unknown}
+
+export function projectEvidence(row: EventRow): EvidenceRecord {
+  const out: EvidenceRecord = { runId: row.run_id, sequence: row.sequence_text,
+    type: /^[A-Za-z0-9_.:-]{1,128}$/.test(row.type) ? row.type : "unknown", occurredAt: row.created_at.toISOString(),
+    selectedModel: null, usageObservations: [], lineage: null, issues: [] }
+  const data = record(row.evidence) ? row.evidence : {}
+  if (row.type === "run.prepared.selected") {
+    const selected = alias(data, ["model", "selectedModel", "selected_model"], model)
+    if (selected.present && selected.valid) out.selectedModel = selected.value as string
+    else out.issues.push("model-unavailable")
+  }
+  if (row.type === "response.usage") {
+    const list = alias(data, ["usageObservations", "usage_observations"], Array.isArray)
+    const invocation = alias(data, ["invocationId", "invocation_id"], identifier)
+    let invalid = !list.present || !list.valid || !invocation.valid || data.usageAliasConflict === true || data.usageObservationsOverflow === true || data.usage_observationsOverflow === true
+    if (list.valid && invocation.valid && data.usageAliasConflict !== true && Array.isArray(list.value)) {
+      if (list.value.length > 16) invalid = true
+      for (const item of list.value.slice(0, 16)) {
+        if (!record(item) || !record(item.usage) ||
+            !["invocation", "latest-model-request", "native-session", "unknown"].includes(String(item.scope)) ||
+            !["complete", "partial", "unknown"].includes(String(item.coverage)) ||
+            (item.coverage === "complete" && item.scope !== "invocation") ||
+            typeof item.source !== "string" || !/^[A-Za-z0-9_-][A-Za-z0-9._-]{0,159}$/.test(item.source)) { invalid = true; continue }
+        const id = alias(item, ["invocationId", "invocation_id"], identifier)
+        const cost = alias(item, ["costUsd", "cost_usd"], v => typeof v === "number" && Number.isFinite(v) && v >= 0)
+        const usage: UsageObservation["usage"] = {}
+        let bad = !id.valid || !cost.valid
+        for (const key of tokens) {
+          const field = alias(item.usage, [key, snake(key)], v => typeof v === "number" && Number.isSafeInteger(v) && v >= 0)
+          if (!field.valid) bad = true
+          else if (field.present) usage[key] = field.value as number
+        }
+        if (bad || !Object.keys(usage).length) { invalid = true; continue }
+        out.usageObservations.push({ scope: item.scope as UsageObservation["scope"], coverage: item.coverage as UsageObservation["coverage"], source: item.source, usage,
+          ...(id.present ? { invocationId: id.value as string } : invocation.present ? { invocationId: invocation.value as string } : {}),
+          ...(cost.present ? { costUsd: cost.value as number } : {}) })
+      }
+    }
+    if (invalid || !out.usageObservations.length) out.issues.push("usage-unavailable")
+  }
+  return out
+}
+
+interface LineageSource {
+  attempt: number; executor: string; provider: string; phase: string
+  native_thread_id: string; native_turn_id: string; native_item_id: string | null; invocation_id: string | null
+}
+
+export function projectLineage(row: LineageSource, receipt: WorkRuntimeRunReceipt): Lineage | null {
+  if (!Number.isSafeInteger(row.attempt) || row.attempt < 1 || row.executor !== "codex-app-server" ||
+      !/^[A-Za-z0-9_.:-]{1,120}$/.test(row.provider) || !identifier(row.native_thread_id) || !identifier(row.native_turn_id) ||
+      !["turn_started", "message_completed", "tool_started", "tool_completed"].includes(row.phase) ||
+      (row.phase === "turn_started" ? row.native_item_id !== null : !identifier(row.native_item_id)) ||
+      !(row.invocation_id === null || identifier(row.invocation_id))) return null
+  const scope = ["demian.native-evidence.v1", receipt.organizationId, receipt.workspaceId, receipt.servicePrincipalId, row.provider, row.executor]
+  const hash = (kind: string, ids: unknown[]) => createHash("sha256").update(JSON.stringify([...scope, kind, ...ids])).digest("hex")
+  return { attempt: row.attempt, executor: row.executor, provider: row.provider, phase: row.phase,
+    nativeThreadKey: hash("thread", [row.native_thread_id]), nativeTurnKey: hash("turn", [row.native_thread_id, row.native_turn_id]),
+    nativeItemKey: row.native_item_id === null ? null : hash("item", [row.native_thread_id, row.native_turn_id, row.native_item_id]), invocationId: row.invocation_id }
+}
+
+// This is a dedicated delegated reader. It never calls the ordinary lineage
+// reader (which deliberately excludes work-runtime sessions).
+export const EVIDENCE_LINEAGE_AUTHORITY_SQL = `SELECT r.id AS run_id,r.organization_id,r.session_id,s.workspace_id,
+  r.requested_by_user_id AS acting_user_id,wb.service_principal_user_id AS service_principal_id,
+  wb.binding_id AS work_binding_id,wb.binding_sha256,m.deployment_membership_id AS membership_id,
+  s.provider,b.binding_id,p.settings_hash,
+  (SELECT n.authority_hash FROM native_lineage_observations n WHERE n.run_id=r.id ORDER BY n.sequence LIMIT 1) AS first_authority_hash
+  FROM runs r JOIN sessions s ON s.id=r.session_id AND s.organization_id=r.organization_id
+  JOIN workspaces w ON w.id=s.workspace_id AND w.organization_id=s.organization_id
+  JOIN organization_members m ON m.organization_id=r.organization_id AND m.user_id=r.requested_by_user_id
+  JOIN users u ON u.id=m.user_id
+  JOIN work_runtime_runs wr ON wr.run_id=r.id AND wr.organization_id=r.organization_id
+  JOIN work_runtime_bindings wb ON wb.organization_id=r.organization_id AND wb.session_id=s.id AND wb.workspace_id=s.workspace_id
+    AND wb.issuer='assistant' AND wb.binding_id=$7 AND wb.binding_sha256=$8
+    AND wb.service_principal_user_id=$6 AND wb.acting_user_id=$5 AND wb.revoked_at IS NULL
+  JOIN deployment_session_bindings b ON b.organization_id=r.organization_id AND b.session_id=s.id AND b.workspace_id=s.workspace_id
+  JOIN deployment_run_authorities p ON p.run_id=r.id AND p.binding_id=b.binding_id
+    AND p.actor_user_id=m.user_id AND p.membership_id=m.deployment_membership_id
+  WHERE r.id=$1 AND r.organization_id=$2 AND r.session_id=$3 AND s.workspace_id=$4
+    AND r.requested_by_user_id=$5 AND r.requested_actor_scope='user' AND r.provider_auth_id IS NULL
+    AND s.archived_at IS NULL AND w.status='ready' AND u.status='active' AND m.role IN ('owner','admin','member')
+    AND s.provider=$9 AND b.binding_id=$10 AND p.settings_hash=$11
+    AND wr.receipt->>'runId'=$1::text AND wr.receipt->>'organizationId'=$2::text
+    AND wr.receipt->>'sessionId'=$3::text AND wr.receipt->>'workspaceId'=$4::text
+    AND wr.receipt->>'actingUserId'=$5::text AND wr.receipt->>'servicePrincipalId'=$6::text
+    AND wr.receipt->'binding'->>'bindingId'=$7 AND wr.receipt->>'bindingSha256'=$8
+    AND wr.receipt->>'sessionProvider'=$9
+  FOR SHARE OF r,s,w,m,u,wr,wb,b,p`
+
+const lineageKeys = ["executor", "provider", "phase", "native_thread_id", "native_turn_id", "native_item_id", "invocation_id"]
+const lineageAuthority = "n.authority_hash=$3 AND n.child_auth_job_id IS NULL AND n.child_authority_id IS NULL AND n.child_provider IS NULL AND e.data->>'provider'=$4"
+// Even invalid indexed observations transfer no raw object, array or large ID.
+// Only the exact selected page sequences are eligible; no message query exists.
+export const EVIDENCE_LINEAGE_SQL = `SELECT e.run_id,e.sequence::text,n.attempt,n.authority_hash,n.semantic_hash,
+  (${lineageAuthority}) IS TRUE AS authorized,
+  (jsonb_typeof(e.data)='object' AND e.data ?& ARRAY[${lineageKeys.map(key => `'${key}'`).join(",")}]
+    AND e.data - ARRAY[${lineageKeys.map(key => `'${key}'`).join(",")}] = '{}'::jsonb) AS exact_source,
+  ${lineageKeys.map(key => `CASE WHEN (${lineageAuthority}) AND jsonb_typeof(e.data->'${key}')='string'
+    AND octet_length(e.data->>'${key}')<=2048 THEN e.data->>'${key}' ELSE NULL END AS ${key}`).join(",\n")},
+  (e.data->'native_item_id'='null'::jsonb) IS TRUE AS item_is_null,
+  (e.data->'invocation_id'='null'::jsonb) IS TRUE AS invocation_is_null
+  FROM run_events e JOIN native_lineage_observations n ON n.run_id=e.run_id AND n.sequence=e.sequence
+  WHERE e.run_id=$1 AND e.sequence=ANY($2::bigint[]) AND e.type='external.lineage.observed'
+    AND cardinality($2::bigint[]) BETWEEN 1 AND 250
+  ORDER BY e.sequence LIMIT 250 FOR SHARE OF e,n`
+
+async function readProtectedLineage(client: DatabaseClient, actor: DelegatedWorkRuntimeActor, receipt: WorkRuntimeRunReceipt, selected: EvidenceRecord[]) {
+  if (!actor.binding.execution) return
+  if (!isDeepStrictEqual(actor.binding, receipt.binding) || actor.bindingSha256 !== receipt.bindingSha256 ||
+      actor.authenticatedServicePrincipalId !== receipt.servicePrincipalId || actor.sessionProvider !== receipt.sessionProvider) throw new WorkRuntimeSignatureError()
+  // Reuses current prepared-service locks, generation/policy/settings validation.
+  // The outer protectedRunRead also holds these locks and checks the receipt.
+  const deployment = await currentPreparedDeployment(client, actor)
+  const args = [receipt.runId, receipt.organizationId, receipt.sessionId, receipt.workspaceId, receipt.actingUserId,
+    receipt.servicePrincipalId, receipt.binding.bindingId, receipt.bindingSha256, receipt.sessionProvider, deployment.bindingId, deployment.settingsHash]
+  const pins = (await client.query<{
+    run_id: string; organization_id: string; session_id: string; workspace_id: string; acting_user_id: string
+    service_principal_id: string; work_binding_id: string; binding_sha256: string; membership_id: string
+    provider: string; binding_id: string; settings_hash: string; first_authority_hash: string | null
+  }>(EVIDENCE_LINEAGE_AUTHORITY_SQL, args)).rows
+  const pin = pins[0]
+  if (pins.length !== 1 || !isDeepStrictEqual([pin.run_id, pin.organization_id, pin.session_id, pin.workspace_id, pin.acting_user_id,
+    pin.service_principal_id, pin.work_binding_id, pin.binding_sha256, pin.provider, pin.binding_id, pin.settings_hash], args)) throw new WorkRuntimeSignatureError()
+  // Exact native writer authority tuple: prepared execution has no personal
+  // provider_auth_id and therefore cannot carry a personal child generation.
+  const authorityHash = createHash("sha256").update(JSON.stringify([receipt.organizationId, receipt.workspaceId, receipt.sessionId,
+    "user", receipt.actingUserId, pin.membership_id, pin.provider, null, pin.binding_id, pin.settings_hash])).digest("hex")
+  if (pin.first_authority_hash !== null && pin.first_authority_hash !== authorityHash) throw new WorkRuntimeSignatureError()
+  const rows = (await client.query<LineageSource & {run_id: string; sequence: string; authority_hash: string; semantic_hash: string;
+    authorized: boolean; exact_source: boolean; item_is_null: boolean; invocation_is_null: boolean}>(
+    EVIDENCE_LINEAGE_SQL, [receipt.runId, selected.map(row => row.sequence), authorityHash, receipt.sessionProvider])).rows
+  const seen = new Set<string>()
+  for (const row of rows) {
+    const item = selected.find(item => item.sequence === row.sequence)
+    if (!item || row.run_id !== receipt.runId || seen.has(row.sequence) || row.authorized !== true ||
+        row.authority_hash !== authorityHash || row.provider !== receipt.sessionProvider || pin.first_authority_hash !== authorityHash) throw new WorkRuntimeSignatureError()
+    seen.add(row.sequence)
+    if (row.exact_source !== true || (row.native_item_id === null && !row.item_is_null) ||
+        (row.invocation_id === null && !row.invocation_is_null)) continue
+    const projected = projectLineage(row, receipt)
+    const semanticHash = createHash("sha256").update(JSON.stringify([row.executor, row.provider, row.native_thread_id,
+      row.native_turn_id, row.phase, row.native_item_id, row.invocation_id])).digest("hex")
+    if (projected && row.semantic_hash === semanticHash) item.lineage = projected
+  }
+}
+
+/** The caller holds run/actor locks and rechecks authority after serialization. */
+export async function readWorkRuntimeEvidence(client: DatabaseClient, actor: DelegatedWorkRuntimeActor, run: RunRow, receipt: WorkRuntimeRunReceipt, query: {after: string; limit: number}) {
+  if (run.id !== receipt.runId || run.organization_id !== receipt.organizationId || run.session_id !== receipt.sessionId ||
+      actor.actingUserId !== receipt.actingUserId || actor.binding.organizationId !== receipt.organizationId ||
+      actor.binding.workspaceId !== receipt.workspaceId || actor.binding.sessionId !== receipt.sessionId ||
+      actor.binding.servicePrincipalId !== receipt.servicePrincipalId) throw new Error("Evidence scope mismatch")
+  const {after, limit} = parseMetadataQuery(`?after=${query.after}&limit=${query.limit}`)
+  const through = (await client.query<{through: string}>("SELECT COALESCE(max(sequence),0)::text AS through FROM run_events WHERE run_id=$1", [run.id])).rows[0].through
+  parseMetadataQuery(`?after=${through}`)
+  if (BigInt(after) > BigInt(through)) throw new MetadataQueryError()
+  const rows = (await client.query<EventRow>(EVIDENCE_EVENTS_SQL, [run.id, after, through, limit + 1])).rows
+  let previous = BigInt(after)
+  for (const row of rows) {
+    parseMetadataQuery(`?after=${row.sequence_text}`)
+    const sequence = BigInt(row.sequence_text)
+    if (row.run_id !== run.id || sequence <= previous || sequence > BigInt(through)) throw new Error("Evidence event scope mismatch")
+    previous = sequence
+  }
+  const records = rows.slice(0, limit).map(projectEvidence)
+  const selected = records.filter(row => row.type === "external.lineage.observed")
+  if (selected.length) {
+    await readProtectedLineage(client, actor, receipt, selected)
+    for (const item of selected) if (!item.lineage) item.issues.push("lineage-unavailable")
+  }
+  const verified = run.status === "succeeded" ? await readWorkRuntimeArtifacts(client, actor, run.id) : []
+  const dates = verified.length ? (await client.query<{id: string; created_at: Date}>(
+    "SELECT id,created_at FROM artifacts WHERE id=ANY($1::uuid[]) AND run_id=$2 ORDER BY id FOR SHARE",
+    [verified.map(value => value.artifact.id), run.id])).rows : []
+  if (dates.length !== verified.length || new Set(dates.map(row => row.id)).size !== dates.length) throw new Error("Evidence artifact scope mismatch")
+  const artifacts = verified.map(({artifact}) => {
+    const date = dates.find(row => row.id === artifact.id)
+    if (!date) throw new Error("Evidence artifact clock missing")
+    return {id: artifact.id, sourceRunId: artifact.source_run_id, sha256: artifact.sha256, filename: artifact.filename,
+      mediaType: artifact.media_type, sizeBytes: artifact.size_bytes, createdAt: date.created_at.toISOString(), bytesVerified: true as const}
+  })
+  const timings: {kind: "queue" | "wall"; source: string; startedAt: string; endedAt: string | null}[] = []
+  if (!run.started_at || run.started_at >= run.created_at) timings.push({kind: "queue", source: "runs.created_at-to-started_at", startedAt: run.created_at.toISOString(), endedAt: run.started_at?.toISOString() ?? null})
+  if (run.started_at && (!run.completed_at || run.completed_at >= run.started_at)) timings.push({kind: "wall", source: "runs.started_at-to-completed_at", startedAt: run.started_at.toISOString(), endedAt: run.completed_at?.toISOString() ?? null})
+  const page = {
+    version: 1 as const, object: "demian.work_runtime.evidence_page" as const, api_version: "2026-09-01" as const, observedAt: new Date().toISOString(),
+    run: {id: run.id, organization_id: run.organization_id, workspace_id: receipt.workspaceId, session_id: run.session_id,
+      acting_user_id: receipt.actingUserId, service_principal_id: receipt.servicePrincipalId, status: run.status,
+      created_at: run.created_at.toISOString(), started_at: run.started_at?.toISOString() ?? null, completed_at: run.completed_at?.toISOString() ?? null,
+      correlation_id: receipt.correlationId, binding_sha256: receipt.bindingSha256, context_sha256: receipt.contextSha256, request_sha256: receipt.requestSha256},
+    events: {after, through_sequence: through, next_after: after, limit, has_more: rows.length > 0, data: [] as EvidenceRecord[]},
+    timings, artifactState: run.status === "succeeded" ? "available" as const : "not-ready" as const, artifacts,
+  }
+  for (const item of records) {
+    page.events.data.push(item)
+    page.events.next_after = item.sequence
+    page.events.has_more = rows.length > page.events.data.length
+    if (Buffer.byteLength(JSON.stringify(page)) >= MAX_BYTES) {
+      page.events.data.pop()
+      page.events.next_after = page.events.data.at(-1)?.sequence ?? after
+      page.events.has_more = true
+      break
+    }
+  }
+  if ((rows.length && !page.events.data.length) || Buffer.byteLength(JSON.stringify(page)) >= MAX_BYTES ||
+      (!page.events.has_more && page.events.next_after !== through)) throw new Error("Evidence page bounds mismatch")
+  return page
+}
