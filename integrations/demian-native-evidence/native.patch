+test("all event sequences, first page, tail and int64 through bounds", async () => {
+  const rows = [event("9007199254740993", "response.created"), event("9007199254740994", "run.prepared.selected", {model: "gpt-6"}), event("9223372036854775807", "response.completed")]
+  const f = fixture(rows)
