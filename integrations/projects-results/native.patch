+    @model_validator(mode="after")
+    def require_result_link(self) -> "AssistantResult":
+        if self.note is not None:
+            return self
+        runtime = self.runtime
+        prefix = "https://assistant.pydemia.ai/#workbench/projects/"
+        if runtime.service != "assistant" or not runtime.url:
+            raise ValueError("Expected an Assistant execution link")
+        instruction, _, execution = runtime.url.removeprefix(prefix).partition(
+            "/executions/"
+        )
+        if (
+            runtime.url != f"{prefix}{instruction}/executions/{execution}"
+            or execution != runtime.run_id
+            or str(UUID(instruction)) != instruction
+            or str(UUID(execution)) != execution
+        ):
+            raise ValueError("Expected the canonical Assistant execution link")
+        return self
+
