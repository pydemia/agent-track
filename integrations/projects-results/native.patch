+@router.post("/tasks/{task_id}/results/{result_id}/note-reference")
+def link_note_reference(
+    request: Request,
+    task_id: str,
+    result_id: str,
+    payload: LinkNoteReference,
+    principal: PrincipalDep,
+    db: DB,
+) -> dict:
+    authorize(db, principal, "results:attach", write=True)
+    allowed_task(db, principal, task_id)
+    digest = operation_hash(
+        "note_reference", f"{task_id}/{result_id}", payload
+    )
+    replay = existing(db, principal, payload.operation_id, digest)
+    if replay is not None:
+        return replay
+    original = existing(db, principal, result_id)
+    if (
+        original is None
+        or original["request_path"] != f"{PREFIX}/tasks/{task_id}/results"
+    ):
+        raise Problem(409, "Original task result unavailable")
+    task = allowed_task(db, principal, task_id, "task.update", lock=True)
+    data = copy.deepcopy(task.data)
+    expected = original["task"]["data"]
+    if (
+        data.get("assistant_result_operation_id") != result_id
+        or data.get("assistant_result") != expected["assistant_result"]
+        or data.get("result_url") != expected["result_url"]
+        or expected["assistant_result"]["note"] is not None
+    ):
+        raise Problem(
+            409, "Current result differs from the original operation"
+        )
+    previous = data.get("assistant_note_reference")
+    if previous and previous["result_operation_id"] == result_id:
+        raise Problem(409, "Note reference already recorded for this result")
+    if previous:
+        history = data.get("assistant_note_reference_history", [])
+        if len(history) >= 100:
+            raise Problem(409, "Preserve the existing Note reference history")
+        data["assistant_note_reference_history"] = [*history, previous]
+    data["assistant_note_reference"] = {
+        "result_operation_id": result_id,
+        "publication_operation_id": payload.publication_operation_id,
+        "note": payload.note.model_dump(),
+    }
+    revise_item(
+        db,
+        task,
+        payload.expected_revision,
+        task.title,
+        task.body,
+        data,
+        status=task.status,
+        actor_id=principal.accountId,
+    )
+    return record(
+        request, db, principal, payload, digest, "note_reference", task
+    )
+
+
