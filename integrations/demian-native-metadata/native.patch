+test("signed metadata rejects current binding, role, permission and policy withdrawal", { skip: !databaseUrl }, async () => {
+  for (const mode of ["binding", "role", "permission", "policy"]) {
+    const s = await setup()
+    try {
+      const done = await finishedWithJournal(s)
+      if (mode === "binding") await revokeWorkRuntimeBinding(s.db, { organizationId, bindingId: s.binding.bindingId, expectedRevision: 1 })
+      if (mode === "role") await s.db.query("UPDATE organization_members SET role='viewer' WHERE organization_id=$1 AND user_id=$2", [organizationId, s.actingUserId])
+      if (mode === "permission") await s.db.query("UPDATE sessions SET permission_policy='ask' WHERE id=$1", [s.sessionId])
+      if (mode === "policy") s.policy.maximumOutputTokens = 64
+      const response = await s.app.inject(s.signed("GET", `/api/v1/runs/${done.runId}/metadata`))
+      assert.equal(response.statusCode, 403, `${mode}: ${response.body}`); noSecrets(response)
+      assert.doesNotMatch(response.body, /metadata_page|sequence_text|binding_sha256/)
+    } finally { await s.close() }
+  }
+})
+
+test("signed metadata rechecks signing key and policy after awaited event SQL", { skip: !databaseUrl }, async () => {
+  for (const mode of ["key", "policy"]) {
+    const s = await setup()
+    try {
+      const done = await finishedWithJournal(s)
+      s.afterMetadata(() => { if (mode === "key") s.withdrawKey(); else s.policy.maximumOutputTokens = 64 })
+      const response = await s.app.inject(s.signed("GET", `/api/v1/runs/${done.runId}/metadata`))
+      assert.equal(response.statusCode, 403, response.body); noSecrets(response)
+      assert.doesNotMatch(response.body, /metadata_page|sequence_text|binding_sha256/)
+    } finally { await s.close() }
+  }
+})
