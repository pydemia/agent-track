diff --git a/apps/api/test/work-runtime-metadata.test.ts b/apps/api/test/work-runtime-metadata.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..3df71ac07381aa4705d7f1481e143fe841f2c46b
--- /dev/null
+++ b/apps/api/test/work-runtime-metadata.test.ts
@@ -0,0 +1,118 @@
+import assert from "node:assert/strict"
+import test from "node:test"
+import Fastify from "fastify"
+import type { DatabaseClient, DatabasePool, RunRow } from "@demian/db"
+import type { WorkRuntimeRunReceipt } from "../../../packages/db/src/work-runtime-runs.ts"
+import { METADATA_EVENTS_SQL, MetadataQueryError, parseMetadataQuery, readWorkRuntimeMetadata, redactMetadataData } from "../src/work-runtime-metadata.ts"
+import { registerWorkRuntimeServer } from "../src/work-runtime-server.ts"
+
+const at = new Date("2026-09-01T00:00:00Z")
+const run = { id: "run", organization_id: "org", session_id: "session", status: "running", created_at: at,
+  started_at: at, completed_at: null, input: "SECRET", output_text: "SECRET", error: "SECRET", usage: { secret: true } } as unknown as RunRow
+const receipt = { runId: "run", organizationId: "org", sessionId: "session", workspaceId: "workspace", correlationId: "correlation",
+  actingUserId: "00000000-0000-0000-0000-000000000011", servicePrincipalId: "00000000-0000-0000-0000-000000000010", bindingSha256: "binding", contextSha256: "context", requestSha256: "request" } as WorkRuntimeRunReceipt
+function fixture(rows: unknown[], through = "9223372036854775807") {
+  const calls: { sql: string; params: unknown[] }[] = []
+  const client = { query: async (sql: string, params: unknown[]) => {
+    calls.push({ sql, params })
+    return { rows: calls.length === 1 ? [{ through }] : rows }
+  } } as unknown as DatabaseClient
+  return { client, calls }
+}
+const event = (sequence_text: string, data: unknown = {}) => ({ run_id: "run", sequence_text, type: "future.event", created_at: at, data })
+
+test("strict signed wire query defaults, bigint and invalid aliases", () => {
+  assert.deepEqual(parseMetadataQuery("/metadata"), { after: "0", limit: 100 })
+  assert.deepEqual(parseMetadataQuery("?after=9223372036854775807&limit=250"), { after: "9223372036854775807", limit: 250 })
+  for (const query of ["after=-1", "after=01", "after=1.0", "after=1e3", "after=9223372036854775808", "after=", "limit=0", "limit=251", "limit=01", "after[]=0", "AFTER=0", "after=0&%61fter=1", "limit=1&limit=2", "unknown=x"]) {
+    assert.throws(() => parseMetadataQuery(`?${query}`), MetadataQueryError, query)
+  }
+})
+
+test("positive redaction keeps trace fields and no nested/private payload", () => {
+  const data = { invocationId: "inv-1", sessionId: "model-session", provider: "openai", model: "gpt-6", durationMs: 12.5,
+    tool: "read_file", ok: false, status: "running", expires_at: "2026-09-01T00:00:00Z",
+    change: { path: "src/main.ts", patch: "SECRET", text: "SECRET" }, input: "SECRET", output: "SECRET", args: "SECRET", results: "SECRET", logs: "SECRET", body: "SECRET", usage: { token: 1 } }
+  const projected = redactMetadataData(data)
+  assert.deepEqual(projected, { invocationId: "inv-1", sessionId: "model-session", provider: "openai", model: "gpt-6", durationMs: 12.5,
+    tool: "read_file", ok: false, status: "running", expires_at: "2026-09-01T00:00:00Z", change: { path: "src/main.ts" } })
+  assert.equal(JSON.stringify(projected).includes("SECRET"), false)
+  assert.deepEqual(redactMetadataData({ model: "free text", provider: "x\nsecret", ok: "true", durationMs: Infinity, tool: "x".repeat(121), change: { path: "a\nb" } }), {})
+})
+
+test("alias conflicts including invalid SQL sentinel cannot create positive relationships", () => {
+  for (const snake of ["other", null, "bad value", "x".repeat(129)]) {
+    assert.deepEqual(redactMetadataData({ invocationId: "good", invocation_id: snake }), {})
+  }
+  assert.deepEqual(redactMetadataData({ invocationId: "same", invocation_id: "same" }), { invocationId: "same", invocation_id: "same" })
+})
+
+test("cowork explicit v1 semantics preserved; invalid/unsupported/oversized flow gets only version stub", () => {
+  const flow = { version: 1, members: [{ memberId: "a", dependsOn: [] }, { memberId: "b", dependsOn: ["a"] }] }
+  assert.deepEqual(redactMetadataData({ flow: JSON.stringify(flow) }), { flow })
+  for (const bad of [ { ...flow, body: "SECRET" }, { version: 1, members: [{ memberId: "a", dependsOn: ["missing"] }, { memberId: "b", dependsOn: [] }] },
+    { version: 1, members: [{ memberId: "a", dependsOn: [] }, { memberId: "a", dependsOn: [] }] } ]) {
+    assert.deepEqual(redactMetadataData({ flow: JSON.stringify(bad) }), { flow: { version: 1 } })
+  }
+  assert.deepEqual(redactMetadataData({ flow: '{"version":2,"body":"SECRET"}' }), { flow: { version: 2 } })
+  assert.deepEqual(redactMetadataData({ flow: "x".repeat(163841) }), { flow: { version: null } })
+})
+
+test("bounded snapshot pagination uses bigint strings, exact DTO and max-first SQL", async () => {
+  const f = fixture([event("9007199254740993", { ok: true, output: "SECRET" }), event("9223372036854775807")])
+  const page = await readWorkRuntimeMetadata(f.client, run, receipt, { after: "9007199254740992", limit: 1 })
+  assert.deepEqual(page, { version: 1, object: "demian.work_runtime.metadata_page", api_version: "2026-09-01",
+    run: { id: "run", organization_id: "org", workspace_id: "workspace", session_id: "session", status: "running",
+      acting_user_id: "00000000-0000-0000-0000-000000000011", service_principal_id: "00000000-0000-0000-0000-000000000010",
+      created_at: at.toISOString(), started_at: at.toISOString(), completed_at: null, correlation_id: "correlation", binding_sha256: "binding", context_sha256: "context", request_sha256: "request" },
+    events: { after: "9007199254740992", through_sequence: "9223372036854775807", next_after: "9007199254740993", limit: 1, has_more: true,
+      data: [{ api_version: "2026-09-01", run_id: "run", sequence_text: "9007199254740993", type: "future.event", created_at: at.toISOString(), data: { ok: true } }] } })
+  assert.match(f.calls[0].sql, /max\(sequence\)/)
+  assert.equal(f.calls[1].sql, METADATA_EVENTS_SQL)
+  assert.deepEqual(f.calls[1].params, ["run", "9007199254740992", "9223372036854775807", 2])
+  assert.match(METADATA_EVENTS_SQL, /octet_length/)
+  assert.match(METADATA_EVENTS_SQL, /sequence<=\$3::bigint/)
+})
+
+test("empty/reset cursor and scope fail closed", async () => {
+  const f = fixture([], "0")
+  const page = await readWorkRuntimeMetadata(f.client, run, receipt, { after: "0", limit: 100 })
+  assert.deepEqual(page.events, { after: "0", through_sequence: "0", next_after: "0", limit: 100, has_more: false, data: [] })
+  await assert.rejects(readWorkRuntimeMetadata(fixture([], "0").client, run, receipt, { after: "1", limit: 1 }), MetadataQueryError)
+  await assert.rejects(readWorkRuntimeMetadata(fixture([]).client, run, { ...receipt, sessionId: "other" }, { after: "0", limit: 1 }), /scope/)
+  for (const row of [{ ...event("1"), run_id: "other" }, event("3"), event("0")]) {
+    await assert.rejects(readWorkRuntimeMetadata(fixture([row], "2").client, run, receipt, { after: "0", limit: 1 }), /scope/)
+  }
+})
+
+test("ordinary bearer and unsigned dedicated service cannot reach metadata storage", async () => {
+  for (const service of [false, true]) {
+    const app = Fastify()
+    const serviceId = "00000000-0000-0000-0000-000000000010"
+    const db = { connect: async () => { throw new Error("Storage must not be reached") } } as unknown as DatabasePool
+    registerWorkRuntimeServer(app, db, { origin: "https://demian.example.invalid", servicePrincipalIds: [serviceId], resolveSigningKey: () => null, resolvePolicy: async () => null },
+      () => ({ userId: service ? serviceId : "ordinary", organizationId: "org", role: "member", email: "", displayName: "", subject: "synthetic", issuer: "synthetic", authMode: "trusted" }))
+    try {
+      const response = await app.inject({ method: "GET", url: "/api/v1/runs/00000000-0000-0000-0000-000000000001/metadata", headers: { authorization: "Bearer synthetic" } })
+      assert.equal(response.statusCode, 403)
+      assert.equal(response.body.includes("Storage must not"), false)
+    } finally { await app.close() }
+  }
+})
+
+test("metadata pages honor a byte budget without losing the continuation cursor", async () => {
+  const ids = Array.from({length:64},(_,index)=>`member_${String(index).padStart(25,"0")}`)
+  const flow = JSON.stringify({version:1,members:ids.map(memberId=>({memberId,dependsOn:ids}))})
+  assert.ok(Buffer.byteLength(flow)<163840)
+  const rows = Array.from({length:10},(_,index)=>event(String(index+1),{flow}))
+  const page = await readWorkRuntimeMetadata(fixture(rows,"10").client,run,receipt,{after:"0",limit:100})
+  assert.ok(page.events.data.length>0&&page.events.data.length<rows.length)
+  assert.equal(page.events.has_more,true)
+  assert.equal(page.events.next_after,String(page.events.data.length))
+  assert.ok(Buffer.byteLength(JSON.stringify(page))<1048576)
+})
+
+test("metadata tool/provider grammars cannot widen the portable contract", () => {
+  assert.deepEqual(redactMetadataData({tool:"tool/path",name:"bad/name",provider:"bad/provider",model:"vendor/model-v1"}),{model:"vendor/model-v1"})
+  assert.throws(()=>parseMetadataQuery("?%61fter=0"),MetadataQueryError)
+})
