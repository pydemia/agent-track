--- /dev/null
+++ b/packages/db/test/deployment-worker-intake.integration.test.ts
@@ -0,0 +1,122 @@
+import assert from "node:assert/strict"
+import { randomUUID } from "node:crypto"
+import { readFile, readdir } from "node:fs/promises"
+import test, { type TestContext } from "node:test"
+import pg from "pg"
+import { bindDeploymentSessionAuthority, createRun, inspectDeploymentSessionAuthority, leaseNextRun,
+  publishDeploymentServiceAuthority, recoverExpiredRuns, syncDeploymentServicePolicies, type WorkerQaTuple } from "../src/index.ts"
+
+const url = process.env.TEST_DATABASE_URL
+const workerId = "deployment-intake-owned"
+async function fixture(t: TestContext) {
+  const schema = "deployment_intake_" + randomUUID().replaceAll("-", "")
+  const scoped = new URL(url!); scoped.searchParams.set("options", "-csearch_path=" + schema)
+  const admin = new pg.Pool({ connectionString: url }), db = new pg.Pool({ connectionString: scoped.href })
+  await admin.query("CREATE SCHEMA " + schema)
+  t.after(async () => { await db.end(); await admin.query("DROP SCHEMA " + schema + " CASCADE"); await admin.end() })
+  assert.equal((await db.query("SELECT current_schema() AS name")).rows[0].name, schema)
+  const dir = new URL("../migrations/", import.meta.url)
+  for (const file of (await readdir(dir)).filter(f => f.endsWith(".sql")).sort()) await db.query(await readFile(new URL(file, dir), "utf8"))
+  const organizationId = "00000000-0000-0000-0000-000000000001", actorUserId = "00000000-0000-0000-0000-000000000010"
+  async function run(owner?: string) {
+    const workspaceId = randomUUID(), sessionId = randomUUID()
+    await db.query("INSERT INTO workspaces(id,organization_id,name,root_path,status) VALUES($1,$2,$3,'/synthetic','ready')", [workspaceId, organizationId, 'fixture-' + workspaceId])
+    await db.query("INSERT INTO sessions(id,organization_id,workspace_id,provider,mode) VALUES($1,$2,$3,'primary','multi-agent')", [sessionId, organizationId, workspaceId])
+    if (!owner) {
+      const runId = randomUUID()
+      await db.query("INSERT INTO runs(id,organization_id,session_id,input,status,created_at) VALUES($1,$2,$3,'[]','queued',now()-interval '1 day')", [runId, organizationId, sessionId])
+      return { organizationId, workspaceId, sessionId, runId }
+    }
+    const source = { configurationId: randomUUID(), revision: "1", sourceIdentity: randomUUID().replaceAll("-", "").repeat(2) }
+    const policy = { organizationId, workspaceId, workerId: owner, providerProfile: "primary", serviceId: randomUUID(), policyRevision: "v1", accountScope: "synthetic" }
+    await syncDeploymentServicePolicies(db, { ...source, policies: [policy] })
+    const pin = await publishDeploymentServiceAuthority(db, { ...policy, materialRevision: "1".repeat(64), providerType: "codex", defaultModel: null, capabilities: { nativeSession: true, multiAgent: true } }, source)
+    const scope = { organizationId, workspaceId, sessionId, actorUserId }
+    const expectedMetadataRevision = (await db.query("SELECT metadata_revision FROM sessions WHERE id=$1", [sessionId])).rows[0].metadata_revision
+    await bindDeploymentSessionAuthority(db, { ...scope, operationId: randomUUID(), expectedMetadataRevision, primary: { serviceId: policy.serviceId, ...pin }, secondary: [] })
+    const view = await inspectDeploymentSessionAuthority(db, scope)
+    assert.ok(view?.available)
+    const created = await createRun(db, { sessionId, organizationId, userId: actorUserId, expectedDeploymentAuthoritySha256: view.settingsHash, idempotencyKey: randomUUID(), items: [{ type: "input_text", text: "synthetic" }] })
+    return { organizationId, workspaceId, sessionId, runId: created.run.id }
+  }
+  async function capability(id = workerId) {
+    await db.query(`INSERT INTO worker_runtime_capabilities(worker_id,default_agent,default_provider,default_mode,features)
+      VALUES($1,'fixture','primary','multi-agent','{"deployment_session_execution_v1":true}')`, [id])
+  }
+  const claim = (id = workerId) => leaseNextRun(db, { workerId: id, leaseSeconds: 90, deploymentOnly: true, deploymentSessionExecution: true })
+  const snapshot = async (ids: string[]) => (await db.query("SELECT to_jsonb(r) AS row FROM runs r WHERE id=ANY($1::uuid[]) ORDER BY id", [ids])).rows
+  const leases = async () => (await db.query("SELECT to_jsonb(l) AS row FROM workspace_leases l ORDER BY workspace_id")).rows
+  const qa = (tuples: WorkerQaTuple[]) => ({ version: 1 as const, expiresAt: new Date(Date.now() + 60_000).toISOString(), tuples })
+  return { db, run, capability, claim, snapshot, leases, qa }
+}
+
+test("deployment-only claims skip older ordinary and foreign Runs and retain capability fences", { skip: !url }, async t => {
+  const f = await fixture(t), ordinary = await f.run(), foreign = await f.run("foreign"), owned = await f.run(workerId)
+  const outside = await f.snapshot([ordinary.runId, foreign.runId])
+  assert.equal(await f.claim(), undefined)
+  await f.capability()
+  assert.equal(await leaseNextRun(f.db, { workerId, leaseSeconds: 90, deploymentOnly: true, deploymentSessionExecution: false }), undefined)
+  await f.db.query("UPDATE worker_runtime_capabilities SET features='{}' WHERE worker_id=$1", [workerId])
+  assert.equal(await f.claim(), undefined)
+  await f.db.query(`UPDATE worker_runtime_capabilities SET features='{"deployment_session_execution_v1":true}',checked_at=now()-interval '2 minutes' WHERE worker_id=$1`, [workerId])
+  assert.equal(await f.claim(), undefined)
+  await f.db.query("UPDATE worker_runtime_capabilities SET checked_at=now() WHERE worker_id=$1", [workerId])
+  assert.equal(await leaseNextRun(f.db, { workerId, leaseSeconds: 90, deploymentOnly: true, qaScope: f.qa([ordinary, foreign]) }), undefined)
+  assert.equal((await f.claim())?.run.id, owned.runId)
+  assert.deepEqual(await f.snapshot([ordinary.runId, foreign.runId]), outside)
+  assert.equal(await f.claim(), undefined)
+})
+
+test("deployment-only missing schema explicitly denies without an ordinary claim", { skip: !url }, async t => {
+  const f = await fixture(t), ordinary = await f.run(), before = await f.snapshot([ordinary.runId])
+  // Rename only within this fresh synthetic schema; preserve all migrated tables.
+  await f.db.query("ALTER TABLE deployment_session_bindings RENAME TO unavailable_bindings")
+  assert.equal(await f.claim(), undefined)
+  await f.db.query("ALTER TABLE unavailable_bindings RENAME TO deployment_session_bindings")
+  await f.db.query("ALTER TABLE deployment_run_authorities RENAME TO unavailable_authorities")
+  assert.equal(await f.claim(), undefined)
+  assert.deepEqual(await f.snapshot([ordinary.runId]), before)
+  assert.deepEqual(await f.leases(), [])
+})
+
+test("deployment recovery intersects QA, Run owner, exact pin and workspace lease owner", { skip: !url }, async t => {
+  const f = await fixture(t), ordinary = await f.run(), foreign = await f.run("foreign"), owned = await f.run(workerId)
+  await f.capability(); await f.capability("foreign")
+  assert.equal((await f.claim())?.run.id, owned.runId)
+  assert.equal((await f.claim("foreign"))?.run.id, foreign.runId)
+  await f.db.query("UPDATE runs SET status='running',worker_id=$2,lease_expires_at=now()-interval '1 hour' WHERE id=$1", [ordinary.runId, workerId])
+  await f.db.query("INSERT INTO workspace_leases(workspace_id,run_id,worker_id,expires_at) VALUES($1,$2,$3,now()-interval '1 hour')", [ordinary.workspaceId, ordinary.runId, workerId])
+  await f.db.query("UPDATE runs SET lease_expires_at=now()-interval '1 hour' WHERE id=ANY($1::uuid[])", [[owned.runId, foreign.runId]])
+  await f.db.query("UPDATE workspace_leases SET expires_at=now()-interval '1 hour'")
+  const outside = await f.snapshot([ordinary.runId, foreign.runId])
+  const outsideLeases = (await f.leases()).filter(row => row.row.run_id !== owned.runId)
+  assert.equal(await recoverExpiredRuns(f.db, f.qa([ordinary, foreign]), { deploymentWorkerId: workerId }), 0)
+  assert.equal((await f.leases()).length, 3)
+  assert.equal(await recoverExpiredRuns(f.db, undefined, { deploymentWorkerId: "unknown-worker" }), 0)
+  await f.db.query("UPDATE workspace_leases SET worker_id='foreign' WHERE run_id=$1", [owned.runId])
+  assert.equal(await recoverExpiredRuns(f.db, f.qa([ordinary, foreign, owned]), { deploymentWorkerId: workerId }), 1)
+  assert.equal((await f.snapshot([owned.runId]))[0].row.status, "failed")
+  assert.equal((await f.leases()).length, 3, "mismatched lease worker must survive even a Run transition")
+  assert.equal(await recoverExpiredRuns(f.db, undefined, { deploymentWorkerId: workerId }), 0)
+  assert.equal((await f.leases()).length, 3)
+  await f.db.query("UPDATE workspace_leases SET worker_id=$2 WHERE run_id=$1", [owned.runId, workerId])
+  assert.equal(await recoverExpiredRuns(f.db, f.qa([owned]), { deploymentWorkerId: workerId }), 0)
+  assert.deepEqual(await f.snapshot([ordinary.runId, foreign.runId]), outside)
+  assert.deepEqual(await f.leases(), outsideLeases)
+  const next = await f.run(workerId)
+  await f.db.query("UPDATE worker_runtime_capabilities SET checked_at=now() WHERE worker_id=$1", [workerId])
+  assert.equal((await f.claim())?.run.id, next.runId)
+  await f.db.query("UPDATE runs SET lease_expires_at=now()-interval '1 hour' WHERE id=$1", [next.runId])
+  assert.equal(await recoverExpiredRuns(f.db, undefined, { deploymentWorkerId: workerId }), 1)
+  assert.equal((await f.snapshot([next.runId]))[0].row.status, "failed")
+  assert.deepEqual(await f.leases(), outsideLeases, "transition removes only the owned lease, even before its expiry")
+  assert.deepEqual(await f.snapshot([ordinary.runId, foreign.runId]), outside)
+})
+
+test("deployment worker options reject empty or padded IDs before connecting", async () => {
+  const db = { connect() { throw Error("must not connect") } } as unknown as pg.Pool
+  for (const deploymentWorkerId of ["", " ", " owned", "owned ", undefined]) {
+    await assert.rejects(recoverExpiredRuns(db, undefined, { deploymentWorkerId: deploymentWorkerId! }), /Invalid deployment worker ID/)
+  }
+  await assert.rejects(leaseNextRun(db, { workerId: " ", leaseSeconds: 90, deploymentOnly: true }), /Invalid deployment worker ID/)
+})
