+  const input = async (overrides: Partial<CreateRunCommandInput> = {}) => {
+    const request = await f.input(overrides)
+    request.recoveryProofSha256 = hash(JSON.stringify(["demian.run-command.recovery.v1",original.bindingSha256,f.actor,
