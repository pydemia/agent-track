index 0000000000000000000000000000000000000000..59869cd28cd4e29c9292e5ac466c15c28f50ff8b
--- /dev/null
+++ b/apps/api/src/run-command-successor.ts
@@ -0,0 +1,54 @@
+import { createHash } from "node:crypto"
+import type { DatabaseClient, RunRow } from "@demian/db"
+import type { RunInputItem } from "@demian/protocol"
+import { insertOrReplayRun, IdempotencyConflictError } from "../../../packages/db/src/index.ts"
+import { getDeploymentRunAuthorityPin, inspectDeploymentSessionAuthority, lockDeploymentScope, pinDeploymentRunAuthority } from "../../../packages/db/src/deployment-services.ts"
+import { RunCommandError } from "../../../packages/db/src/run-commands.ts"
+import { normalizeArtifactDatabaseError } from "../../../packages/db/src/artifacts.ts"
+
+/** Called only within the command transaction after its current-authority fence. */
+export async function createOrdinaryCommandSuccessor(client: DatabaseClient, input: {
+  sourceRun: RunRow; commandId: string; items: RunInputItem[]
+}): Promise<RunRow> {
+  const source = input.sourceRun
+  if (!source.requested_by_user_id || source.requested_actor_scope !== "user") throw new IdempotencyConflictError()
+  const managed = await client.query(`SELECT 1 WHERE
+    EXISTS(SELECT 1 FROM work_runtime_runs WHERE run_id=$1) OR
+    EXISTS(SELECT 1 FROM managed_child_receipts WHERE run_id=$1) OR
+    EXISTS(SELECT 1 FROM peer_processing_receipts WHERE run_id=$1)`, [source.id])
+  if (managed.rowCount) throw new IdempotencyConflictError()
+  const session = (await client.query<{ workspace_id: string; mode: string }>(
+    "SELECT workspace_id,mode FROM sessions WHERE organization_id=$1 AND id=$2", [source.organization_id, source.session_id])).rows[0]
+  if (!session) throw new IdempotencyConflictError()
+  if (input.items.some(item => item.type === "input_artifact")) {
+    if (session.mode !== "single-agent") throw new RunCommandError(400, "artifact_mode_unsupported")
+    const workers = (await client.query<{ total: number; compatible: number }>(
+      `SELECT count(*)::int AS total,count(*) FILTER(WHERE features->'web_artifact_inputs_v1'='true'::jsonb)::int AS compatible
+       FROM worker_runtime_capabilities WHERE checked_at>clock_timestamp()-interval '90 seconds' AND checked_at<=clock_timestamp()`)).rows[0]
+    if (!workers || workers.total === 0 || workers.total !== workers.compatible) throw new RunCommandError(503, "artifact_runtime_unavailable")
+  }
+  const scope = { organizationId: source.organization_id, workspaceId: session.workspace_id,
+    sessionId: source.session_id, actorUserId: source.requested_by_user_id }
+  const expected = await getDeploymentRunAuthorityPin(client, source.id)
+  if (!expected && (await client.query("SELECT 1 FROM deployment_session_bindings WHERE session_id=$1", [source.session_id])).rowCount)
+    throw new IdempotencyConflictError()
+  if (expected) {
+    await lockDeploymentScope(client, scope)
+    const current = await inspectDeploymentSessionAuthority(client, scope)
+    if (!current?.available || current.settingsHash !== expected) throw new IdempotencyConflictError()
+  }
+  const requestHash = createHash("sha256").update(JSON.stringify([source.session_id, source.requested_by_user_id, input.items])).digest("hex")
+  const result = await insertOrReplayRun(client, { organizationId: source.organization_id, sessionId: source.session_id,
+    userId: source.requested_by_user_id, items: input.items,
+    idempotencyKey: `run-command:${source.requested_by_user_id}:${input.commandId}`, requestId: input.commandId,
+    ...(source.provider_auth_id ? { providerAuthId: source.provider_auth_id } : {}) }, requestHash).catch(error => {
+      if (error && typeof error === "object" && "constraint" in error && typeof error.constraint === "string" && error.constraint.startsWith("artifact_"))
+        normalizeArtifactDatabaseError(error)
+      throw error
+    })
+  if (result.replayed) throw new IdempotencyConflictError()
+  if (expected) await pinDeploymentRunAuthority(client, { ...scope, runId: result.run.id, expectedSettingsHash: expected })
+  await client.query("INSERT INTO run_event_counters(run_id,next_sequence) VALUES($1,2)", [result.run.id])
+  await client.query("INSERT INTO run_events(run_id,sequence,type,data) VALUES($1,1,'response.created',$2)", [result.run.id, { status: "queued" }])
+  return result.run
+}
diff --git a/apps/api/src/run-commands.ts b/apps/api/src/run-commands.ts
new file mode 100644
index 0000000000000000000000000000000000000000..c98e51c52bd0e6d3fb4532d56f500d99632ff9dc
--- /dev/null
+++ b/apps/api/src/run-commands.ts
@@ -0,0 +1,153 @@
+import { createHash } from "node:crypto"
+import type { FastifyInstance, FastifyRequest } from "fastify"
+import { getRun, type DatabaseClient, type DatabasePool, type RunRow } from "@demian/db"
+import { ProtocolValidationError, parseRunInput } from "@demian/protocol"
+import { createRunCommand, getRunCommandHead, readRunCommand, RunCommandError,
+  type RunCommandKind, type RunCommandResult, type RunCommandReceipt } from "../../../packages/db/src/run-commands.ts"
+import { getDeploymentRunAuthorityPin, inspectDeploymentSessionAuthority, lockDeploymentScope } from "../../../packages/db/src/deployment-services.ts"
+import { createOrdinaryCommandSuccessor } from "./run-command-successor.ts"
+import { parseWorkRuntimeCommandDescriptor } from "./work-runtime-package.ts"
+import type { Principal } from "./auth.ts"
+
+const sha = (value: unknown) => createHash("sha256").update(JSON.stringify(value)).digest("hex")
+const uuid = /^[a-f0-9]{8}(?:-[a-f0-9]{4}){3}-[a-f0-9]{12}$/
+export interface NativeRunCommandContext {
+  object: "demian.run_command_context"
+  version: 1
+  source_run: { id: string; session_id: string; status: string }
+  session_head_sha256: string
+  authority_sha256: string
+  available_kinds: RunCommandKind[]
+  observed_at: string
+}
+export interface DelegatedRunCommands {
+  hasContext(request: FastifyRequest): boolean
+  commandContext(request: FastifyRequest, sourceRunId: string): Promise<NativeRunCommandContext>
+  command(request: FastifyRequest, sourceRunId: string): Promise<RunCommandResult>
+  commandReceipt(request: FastifyRequest, sessionId: string, commandId: string): Promise<RunCommandResult | undefined>
+}
+export function runCommandResource(row: RunCommandReceipt) {
+  return { object: "demian.run_command_receipt", version: 1, command_id: row.command_id,
+    session_id: row.session_id, source_run_id: row.source_run_id, kind: row.kind,
+    outcome: row.outcome, rejection_code: row.rejection_code, new_run_id: row.new_run_id,
+    task_root_run_id: row.task_root_run_id, relation: row.relation,
+    created_at: row.created_at.toISOString(), expires_at: row.expires_at.toISOString() }
+}
+export function availableRunCommands(status: string, active: boolean): RunCommandKind[] {
+  if (active) return []
+  return status === "failed" ? ["retry", "continue"] :
+    ["cancelled", "expired"].includes(status) ? ["resume", "continue"] : status === "succeeded" ? ["continue"] : []
+}
+
+/** One route composition for ordinary users and the separately signed owner path. */
+export function registerRunCommands(app: FastifyInstance, db: DatabasePool, options: {
+  principalFor(request: FastifyRequest): Principal
+  authorize(principal: Principal, action: string, resource: { kind: string; id: string; organizationId: string }): Promise<void>
+  delegated?: DelegatedRunCommands
+}) {
+  const noBody = (request: FastifyRequest) => {
+    if (request.body !== undefined || request.headers["transfer-encoding"] !== undefined || Number(request.headers["content-length"] ?? 0) !== 0 ||
+        (request.raw.url ?? request.url).includes("?")) throw new ProtocolValidationError("Command reads do not accept a body or query")
+  }
+  const principal = (request: FastifyRequest) => options.principalFor(request)
+  const sourceFor = async (request: FastifyRequest, id: string) => {
+    if (!uuid.test(id)) throw new ProtocolValidationError("Invalid Run identifier")
+    const actor = principal(request), source = await getRun(db, actor.organizationId, id)
+    if (!source || source.requested_by_user_id !== actor.userId || source.requested_actor_scope !== "user") throw new RunCommandError(404, "command_unavailable")
+    return source
+  }
+  const authorize = async (request: FastifyRequest, client: DatabaseClient, source: RunRow): Promise<string> => {
+    const actor = principal(request)
+    await options.authorize(actor, "view", { kind: "session", id: source.session_id, organizationId: actor.organizationId })
+    await options.authorize(actor, "create", { kind: "run", id: "new", organizationId: actor.organizationId })
+    const rows = await client.query<{ workspace_id: string; root_path: string; agent: string; provider: string;
+      model: string | null; mode: string; permission_policy: string; role: string; provider_auth_id: string | null; generation: string | null }>(
+      `SELECT s.workspace_id,w.root_path,s.agent,s.provider,s.model,s.mode,s.permission_policy,m.role,c.auth_job_id AS provider_auth_id,c.xmin::text AS generation
+       FROM runs r JOIN sessions s ON s.id=r.session_id AND s.organization_id=r.organization_id
+       JOIN workspaces w ON w.id=s.workspace_id AND w.organization_id=s.organization_id
+       JOIN organization_members m ON m.organization_id=r.organization_id AND m.user_id=$2
+       JOIN users u ON u.id=m.user_id
+       LEFT JOIN user_provider_connections c ON c.organization_id=r.organization_id AND c.user_id=m.user_id AND c.provider=s.provider
+       WHERE r.id=$1 AND r.organization_id=$3 AND r.requested_by_user_id=$2 AND r.requested_actor_scope='user'
+         AND u.status='active' AND m.role IN ('owner','admin','member') AND w.status='ready' AND s.archived_at IS NULL
+         AND NOT EXISTS(SELECT 1 FROM work_runtime_runs p WHERE p.run_id=r.id)
+         AND NOT EXISTS(SELECT 1 FROM work_runtime_bindings p WHERE p.session_id=s.id)
+         AND NOT EXISTS(SELECT 1 FROM managed_child_receipts p WHERE p.run_id=r.id)
+         AND NOT EXISTS(SELECT 1 FROM peer_processing_receipts p WHERE p.run_id=r.id)
+       FOR SHARE OF s,w,m,u`, [source.id, actor.userId, actor.organizationId])
+    const row = rows.rows[0]
+    if (!row || rows.rows.length !== 1 || row.role !== actor.role) throw new RunCommandError(403, "command_authority_denied")
+    const pin = await getDeploymentRunAuthorityPin(client, source.id)
+    const { provider_auth_id: personalAuth, generation: personalGeneration, ...sessionAuthority } = row
+    if (pin) {
+      const scope = { organizationId: actor.organizationId, workspaceId: row.workspace_id, sessionId: source.session_id, actorUserId: actor.userId }
+      await lockDeploymentScope(client, scope)
+      const current = await inspectDeploymentSessionAuthority(client, scope)
+      if (source.provider_auth_id !== null || !current?.available || current.settingsHash !== pin) throw new RunCommandError(403, "command_authority_denied")
+    } else {
+      if (personalAuth !== (source.provider_auth_id ?? null) ||
+          (await client.query("SELECT 1 FROM deployment_session_bindings WHERE session_id=$1", [source.session_id])).rowCount) throw new RunCommandError(403, "command_authority_denied")
+      if (personalAuth && !(await client.query(
+        `SELECT c.auth_job_id FROM user_provider_connections c JOIN provider_auth_jobs j ON j.id=c.auth_job_id
+         AND j.organization_id=c.organization_id AND j.user_id=c.user_id AND j.provider=c.provider
+         WHERE c.organization_id=$1 AND c.user_id=$2 AND c.provider=$3 AND c.auth_job_id=$4 AND j.status='succeeded'
+         FOR SHARE OF c,j`, [actor.organizationId, actor.userId, row.provider, personalAuth])).rowCount) throw new RunCommandError(403, "command_authority_denied")
+    }
+    return sha(["demian.ordinary-run-command.v1", actor.organizationId, actor.userId, source.id, sessionAuthority,
+      pin ? { deploymentSettingsHash: pin } : { personalAuth, personalGeneration }])
+  }
+  app.get<{ Params: { runId: string } }>("/api/v1/runs/:runId/command-context", async (request, reply) => {
+    noBody(request); reply.header("cache-control", "no-store")
+    if (options.delegated?.hasContext(request)) return options.delegated.commandContext(request, request.params.runId)
+    const source = await sourceFor(request, request.params.runId), client = await db.connect()
+    try {
+      await client.query("BEGIN")
+      const stamp = await authorize(request, client, source), head = await getRunCommandHead(client, source.organization_id, source.session_id)
+      const active = (await client.query("SELECT 1 FROM runs WHERE session_id=$1 AND status IN ('queued','leasing','running','waiting_for_permission','cancelling') LIMIT 1", [source.session_id])).rowCount! > 0
+      if (await authorize(request, client, source) !== stamp) throw new RunCommandError(403, "command_authority_denied")
+      const result: NativeRunCommandContext = { object: "demian.run_command_context", version: 1,
+        source_run: { id: source.id, session_id: source.session_id, status: source.status }, session_head_sha256: head,
+        authority_sha256: stamp, available_kinds: availableRunCommands(source.status, active), observed_at: new Date().toISOString() }
+      await client.query("COMMIT"); return result
+    } catch (error) { await client.query("ROLLBACK"); throw error } finally { client.release() }
+  })
+  app.post<{ Params: { runId: string } }>("/api/v1/runs/:runId/commands", async (request, reply) => {
+    reply.header("cache-control", "no-store")
+    if ((request.raw.url ?? request.url).includes("?")) throw new ProtocolValidationError("Command writes do not accept query parameters")
+    let result: RunCommandResult
+    if (options.delegated?.hasContext(request)) result = await options.delegated.command(request, request.params.runId)
+    else {
+      const source = await sourceFor(request, request.params.runId), body = request.body as Record<string, unknown>
+      if (!body || typeof body !== "object" || Array.isArray(body)) throw new ProtocolValidationError("A command object is required")
+      let command
+      try { command = parseWorkRuntimeCommandDescriptor(body.command) } catch { throw new ProtocolValidationError("Invalid command descriptor") }
+      if (command.sourceRunId !== source.id || Object.keys(body).some(key => !["command", "input"].includes(key)) ||
+          (command.kind === "continue" ? body.input === undefined : Object.hasOwn(body, "input"))) throw new ProtocolValidationError("Command input does not match its kind")
+      const continuation = command.kind === "continue" ? parseRunInput(body.input) : undefined
+      const intent = { command, ...(continuation ? { input: continuation } : {}) }
+      result = await createRunCommand(db, { organizationId: source.organization_id, sessionId: source.session_id,
+        actorUserId: principal(request).userId, sourceRunId: source.id, commandId: command.commandId, kind: command.kind,
+        expectedSessionHead: command.expectedSessionHead, expectedSourceStatus: command.expectedSourceStatus,
+        expectedAuthoritySha256: command.expectedAuthoritySha256, expiresAt: command.expiresAt, intentSha256: sha(intent),
+        ...(continuation ? { continuationItems: continuation } : {}) }, {
+        authorize: (client, row) => authorize(request, client, row),
+        createSuccessor: (client, input) => createOrdinaryCommandSuccessor(client, input),
+      })
+    }
+    return reply.code(result.receipt.outcome === "rejected" ? 409 : result.replayed ? 200 : 202).send(runCommandResource(result.receipt))
+  })
+  app.get<{ Params: { sessionId: string; commandId: string } }>("/api/v1/sessions/:sessionId/commands/:commandId", async (request, reply) => {
+    noBody(request); reply.header("cache-control", "no-store")
+    if (!uuid.test(request.params.sessionId) || !uuid.test(request.params.commandId)) throw new ProtocolValidationError("Invalid command identifier")
+    if (options.delegated?.hasContext(request)) {
+      const result = await options.delegated.commandReceipt(request, request.params.sessionId, request.params.commandId)
+      return { object: "demian.run_command_status", version: 1, status: result ? "found" : "not_found", receipt: result ? runCommandResource(result.receipt) : null }
+    }
+    const actor = principal(request)
+    await options.authorize(actor, "view", { kind: "session", id: request.params.sessionId, organizationId: actor.organizationId })
+    await options.authorize(actor, "create", { kind: "run", id: "new", organizationId: actor.organizationId })
+    const result = await readRunCommand(db, { organizationId: actor.organizationId, actorUserId: actor.userId,
+      sessionId: request.params.sessionId, commandId: request.params.commandId }, { authorize: (client, row) => authorize(request, client, row) })
+    return { object: "demian.run_command_status", version: 1, status: result ? "found" : "not_found", receipt: result ? runCommandResource(result.receipt) : null }
+  })
+}
