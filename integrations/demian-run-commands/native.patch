+// Facade forwards real PostgreSQL COMMIT, then loses only its acknowledgement.
+function lostCommitPool(db: DatabasePool): DatabasePool {
+  return new Proxy(db, {get(target, key) {
+    if (key !== "connect") return Reflect.get(target,key)
+    return async () => {
+      const client = await target.connect()
+      return new Proxy(client, {get(connection, property) {
+        if (property === "query") return async (...args: unknown[]) => {
+          const result = await Reflect.apply(connection.query,connection,args)
+          if (args[0] === "COMMIT") throw new Error("synthetic lost COMMIT acknowledgement")
+          return result
+        }
+        const value = Reflect.get(connection,property)
+        return typeof value === "function" ? value.bind(connection) : value
+      }}) as DatabaseClient
+    }
+  }})
+}
