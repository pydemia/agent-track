new file mode 100644
index 0000000000000000000000000000000000000000..bf7edb581b65d5bcb9439915ea622508535c94fc
--- /dev/null
+++ b/packages/db/migrations/027_run_commands.sql
@@ -0,0 +1,71 @@
+-- AT-09 immutable admission receipts. No inputs, context, or credentials.
+ALTER TABLE runs ADD CONSTRAINT runs_command_scope_unique
+  UNIQUE (organization_id, session_id, id);
+CREATE TABLE run_commands (
+  organization_id uuid NOT NULL,
+  session_id uuid NOT NULL,
+  actor_user_id uuid NOT NULL,
+  command_id uuid NOT NULL,
+  source_run_id uuid NOT NULL,
+  accepted_source_run_id uuid,
+  kind text NOT NULL CHECK (kind IN ('retry','resume','continue')),
+  request_sha256 text NOT NULL CHECK (request_sha256 ~ '^[a-f0-9]{64}$'),
+  intent_sha256 text NOT NULL CHECK (intent_sha256 ~ '^[a-f0-9]{64}$'),
+  expected_session_head text NOT NULL CHECK (expected_session_head ~ '^[a-f0-9]{64}$'),
+  expected_source_status text NOT NULL CHECK (expected_source_status IN ('succeeded','failed','cancelled','expired')),
+  expected_authority_sha256 text NOT NULL CHECK (expected_authority_sha256 ~ '^[a-f0-9]{64}$'),
+  source_input_sha256 text NOT NULL CHECK (source_input_sha256 ~ '^[a-f0-9]{64}$'),
+  recovery_proof_sha256 text CHECK (recovery_proof_sha256 ~ '^[a-f0-9]{64}$'),
+  expires_at timestamptz NOT NULL,
+  outcome text NOT NULL CHECK (outcome IN ('accepted','rejected')),
+  rejection_code text CHECK (rejection_code IN ('command_expired','session_head_changed',
+    'source_status_changed','active_run','invalid_source_state')),
+  new_run_id uuid,
+  task_root_run_id uuid,
+  relation text CHECK (relation IN ('retry_of','continues')),
+  created_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  PRIMARY KEY (organization_id, actor_user_id, command_id),
+  FOREIGN KEY (organization_id,session_id) REFERENCES sessions(organization_id,id) ON DELETE CASCADE,
+  -- Rejected intents must not wait on an active worker's Run UPDATE lock.
+  -- Their attempted source identity is scope-checked by the INSERT trigger.
+  FOREIGN KEY (organization_id,session_id,accepted_source_run_id)
+    REFERENCES runs(organization_id,session_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (organization_id,session_id,new_run_id)
+    REFERENCES runs(organization_id,session_id,id) ON DELETE CASCADE,
+  FOREIGN KEY (organization_id,session_id,task_root_run_id)
+    REFERENCES runs(organization_id,session_id,id) ON DELETE CASCADE,
+  CHECK ((outcome='accepted' AND rejection_code IS NULL AND new_run_id IS NOT NULL
+    AND accepted_source_run_id IS NOT NULL AND accepted_source_run_id=source_run_id
+    AND new_run_id<>source_run_id AND task_root_run_id IS NOT NULL AND relation IS NOT NULL
+    AND relation=CASE WHEN kind='retry' THEN 'retry_of' ELSE 'continues' END
+    AND (kind<>'continue' OR task_root_run_id=new_run_id))
+    OR (outcome='rejected' AND rejection_code IS NOT NULL AND new_run_id IS NULL AND accepted_source_run_id IS NULL
+      AND task_root_run_id IS NULL AND relation IS NULL))
+);
+CREATE UNIQUE INDEX run_commands_accepted_head_idx
+  ON run_commands(organization_id,session_id,expected_session_head) WHERE outcome='accepted';
+CREATE UNIQUE INDEX run_commands_successor_idx
+  ON run_commands(new_run_id) WHERE outcome='accepted';
+CREATE FUNCTION guard_run_command_scope() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  IF EXISTS (
+    SELECT 1 FROM runs r WHERE r.id IN (NEW.source_run_id,NEW.new_run_id,NEW.task_root_run_id)
+      AND (r.organization_id<>NEW.organization_id OR r.session_id<>NEW.session_id
+        OR r.requested_by_user_id IS DISTINCT FROM NEW.actor_user_id
+        OR r.requested_actor_scope<>'user')
+  ) THEN
+    RAISE EXCEPTION 'Invalid command run scope' USING ERRCODE='23514';
+  END IF;
+  RETURN NEW;
+END;
+$$;
+CREATE TRIGGER run_commands_scope BEFORE INSERT ON run_commands
+  FOR EACH ROW EXECUTE FUNCTION guard_run_command_scope();
+CREATE FUNCTION immutable_run_command() RETURNS trigger LANGUAGE plpgsql AS $$
+BEGIN
+  RAISE EXCEPTION 'Run command receipts are immutable' USING ERRCODE='23514';
+END;
+$$;
+-- Deliberately no DELETE trigger: authorized Session deletion must cascade.
+CREATE TRIGGER run_commands_immutable BEFORE UPDATE ON run_commands
+  FOR EACH ROW EXECUTE FUNCTION immutable_run_command();
