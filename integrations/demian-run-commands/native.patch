+test("ordinary retry HTTP admits one successor and recovers its receipt without returning private pins", options, async () => {
+  const f=await fixture()
+  try {
+    const before=await f.original(),body=await f.intent(),created=await f.post(body)
+    assert.equal(created.statusCode,202,created.body)
+    const receipt=created.json();assert.equal(receipt.outcome,"accepted");assert.equal(receipt.relation,"retry_of");assert.equal(receipt.task_root_run_id,f.source)
+    const next=(await f.db.query("SELECT input FROM runs WHERE id=$1",[receipt.new_run_id])).rows[0]
+    assert.deepEqual(next.input,[{type:"input_text",text:"PRIVATE ORIGINAL TASK"}]);assert.equal(await f.original(),before)
+    const replay=await f.post(body);assert.equal(replay.statusCode,200,replay.body);assert.equal(replay.json().new_run_id,receipt.new_run_id)
+    const recovered=await f.app.inject({method:"GET",url:`/api/v1/sessions/${f.session}/commands/${body.command.commandId}`,headers})
+    assert.equal(recovered.statusCode,200,recovered.body);assert.equal(recovered.json().receipt.new_run_id,receipt.new_run_id)
+    assert.doesNotMatch(created.body,/PRIVATE|authority_sha|request_sha|actor_user|recovery_proof/)
+    const conflict=await f.post({...body,command:{...body.command,expiresAt:new Date(Date.now()+80_000).toISOString()}})
+    assert.equal(conflict.statusCode,409,conflict.body);assert.equal(conflict.json().code,"command_digest_conflict")
+    const events=(await f.db.query("SELECT type FROM run_events WHERE run_id=$1 ORDER BY sequence",[receipt.new_run_id])).rows
+    assert.deepEqual(events.map(row=>row.type),["response.created","run.command.created"])
+  } finally { await f.close() }
+})
