+import assert from "node:assert/strict"
+import { randomUUID } from "node:crypto"
+import { readdir, readFile } from "node:fs/promises"
+import { createServer } from "node:http"
+import test from "node:test"
+import { createDatabase, bindDeploymentSessionAuthority, configureDeploymentService, publishDeploymentServiceAuthority,
+  inspectDeploymentSessionAuthority, pinDeploymentRunAuthority } from "@demian/db"
+import { buildServer } from "../src/server.ts"
+import type { ApiConfig } from "../src/config.ts"
+
+const databaseUrl = process.env.TEST_DATABASE_URL
+const options = { skip: !databaseUrl }
+const org = "00000000-0000-0000-0000-000000000001", actor = "00000000-0000-0000-0000-000000000010"
+const headers = { authorization: "Bearer synthetic-command-test" }
+async function fixture(status = "failed", withPolicy = false) {
+  const admin = createDatabase({ connectionString: databaseUrl! }), schema = `command_http_${randomUUID().replaceAll("-", "")}`
+  await admin.query(`CREATE SCHEMA "${schema}"`)
+  const url = new URL(databaseUrl!); url.searchParams.set("options", `-csearch_path=${schema}`)
+  const db = createDatabase({ connectionString: url.href }), workspace = randomUUID(), session = randomUUID(), source = randomUUID()
+  let allowed = true, revokeAfterInsert = false
+  const policy = createServer((_request, response) => response.writeHead(200, { "content-type": "application/json" }).end(JSON.stringify({results:[{actions:{view:allowed?"EFFECT_ALLOW":"EFFECT_DENY",create:allowed?"EFFECT_ALLOW":"EFFECT_DENY"}}]})))
+  try {
+    const migrations = new URL("../../../packages/db/migrations/", import.meta.url)
+    for (const file of (await readdir(migrations)).filter(file => file.endsWith(".sql")).sort()) await db.query(await readFile(new URL(file, migrations), "utf8"))
+    await db.query("INSERT INTO users(id,email,display_name) VALUES($1,'synthetic-owner@example.invalid','Synthetic') ON CONFLICT(id) DO NOTHING", [actor])
+    await db.query("INSERT INTO organization_members(organization_id,user_id,role) VALUES($1,$2,'owner') ON CONFLICT(organization_id,user_id) DO UPDATE SET role='owner'", [org, actor])
+    await db.query("INSERT INTO workspaces(id,organization_id,name,root_path,status) VALUES($1,$2,'Synthetic','/synthetic','ready')", [workspace, org])
+    await db.query("INSERT INTO sessions(id,organization_id,workspace_id,agent,provider,model,permission_policy) VALUES($1,$2,$3,'build','synthetic','model','deny')", [session,org,workspace])
+    await db.query("INSERT INTO runs(id,organization_id,session_id,requested_by_user_id,input,status) VALUES($1,$2,$3,$4,$5::jsonb,$6)", [source,org,session,actor,JSON.stringify([{type:"input_text",text:"PRIVATE ORIGINAL TASK"}]),status])
+    await db.query("INSERT INTO run_events(run_id,sequence,type,data) VALUES($1,1,'response.failed','{\"reason\":\"PRIVATE ORIGINAL EVENT\"}')", [source])
+    let policyUrl: string | undefined
+    if (withPolicy) {
+      await new Promise<void>(resolve => policy.listen(0,"127.0.0.1",resolve))
+      const address = policy.address(); assert(address && typeof address !== "string"); policyUrl = `http://127.0.0.1:${address.port}`
+      const seen = new WeakSet<object>()
+      db.on("acquire", client => {
+        if (seen.has(client)) return; seen.add(client)
+        const original = client.query.bind(client)
+        client.query = ((...args: Parameters<typeof original>) => {
+          const result = original(...args)
+          if (revokeAfterInsert && typeof args[0] === "string" && /^\s*INSERT INTO runs\s*\(/.test(args[0]))
+            return Promise.resolve(result).then(value => { allowed = false; return value })
+          return result
+        }) as typeof client.query
+      })
+    }
